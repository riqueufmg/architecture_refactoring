    {
      "op": "EXTRACT_CLASS",
      "inputs": [
        "src/main/java/org/jsoup/Jsoup.java"
      ],
      "outputs": [
        "src/main/java/org/jsoup/JsoupCleaner.java"
      ],
      "details": "Create new class org.jsoup.JsoupCleaner containing the implementations of the cleaning-related static methods extracted from Jsoup: clean(String bodyHtml, String baseUri, Safelist safelist), clean(String bodyHtml, Safelist safelist), clean(String bodyHtml, String baseUri, Safelist safelist, Document.OutputSettings outputSettings), and isValid(String bodyHtml, Safelist safelist). Implementations are copied from Jsoup but call Parser.parseBodyFragment(...) instead of Jsoup.parseBodyFragment(...) so the new class does not depend on moved implementations. The new class is declared in package org.jsoup and provides public static methods with the same signatures as the originals.",
      "risk": "low"
    },
    {
      "op": "ADD_OR_UPDATE_IMPORTS",
      "inputs": [
        "src/main/java/org/jsoup/JsoupCleaner.java"
      ],
      "outputs": [
        "src/main/java/org/jsoup/JsoupCleaner.java"
      ],
      "details": "Add required imports to JsoupCleaner.java: import org.jsoup.nodes.Document; import org.jsoup.safety.Cleaner; import org.jsoup.safety.Safelist; import org.jsoup.parser.Parser; and add static import for org.jsoup.internal.SharedConstants.DummyUri. Ensure the file compiles referencing only existing project classes.",
      "risk": "low"
    },
    {
      "op": "UPDATE_CALL_SITES",
      "inputs": [
        "src/main/java/org/jsoup/Jsoup.java"
      ],
      "outputs": [
        "src/main/java/org/jsoup/Jsoup.java"
      ],
      "details": "Replace the bodies of the public static Jsoup methods related to cleaning with delegating calls to JsoupCleaner while keeping the original method signatures intact. Specifically: - Jsoup.clean(String, String, Safelist) -> return JsoupCleaner.clean(bodyHtml, baseUri, safelist); - Jsoup.clean(String, Safelist) -> return JsoupCleaner.clean(bodyHtml, safelist); - Jsoup.clean(String, String, Safelist, Document.OutputSettings) -> return JsoupCleaner.clean(bodyHtml, baseUri, safelist, outputSettings); - Jsoup.isValid(String, Safelist) -> return JsoupCleaner.isValid(bodyHtml, safelist); Leave all other Jsoup methods unchanged. This preserves the public Jsoup API while moving the cleaning logic to the new class.",
      "risk": "low"
    },
