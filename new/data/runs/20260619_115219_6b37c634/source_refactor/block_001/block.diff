+package org.apache.commons.lang3.mutable;
+
+/**
+ * Encapsulates the mutable byte value and provides arithmetic and mutation operations.
+ * This class is a helper used by {@link MutableByte} to concentrate mutation logic.
+ *
+ * @since 3.12 (extracted)
+ */
+public class MutableByteArithmetic {
+
+    /**
+     * Required for serialization support.
+     */
+    private static final long serialVersionUID = -1585823265L;
+
+    /** The mutable value. */
+    private byte value;
+
+    /**
+     * Constructs a new MutableByteArithmetic with the default value of zero.
+     */
+    public MutableByteArithmetic() {
+    }
+
+    /**
+     * Constructs a new MutableByteArithmetic with the specified value.
+     *
+     * @param value the initial value to store
+     */
+    public MutableByteArithmetic(final byte value) {
+        this.value = value;
+    }
+
+    /**
+     * Constructs a new MutableByteArithmetic with the specified value.
+     *
+     * @param value the initial value to store, not null.
+     */
+    public MutableByteArithmetic(final Number value) {
+        this.value = value.byteValue();
+    }
+
+    /**
+     * Constructs a new MutableByteArithmetic parsing the given string.
+     *
+     * @param value the string to parse, not null.
+     */
+    public MutableByteArithmetic(final String value) {
+        this.value = Byte.parseByte(value);
+    }
+
+    public void add(final byte operand) {
+        this.value += operand;
+    }
+
+    public void add(final Number operand) {
+        this.value += operand.byteValue();
+    }
+
+    public byte addAndGet(final byte operand) {
+        this.value += operand;
+        return this.value;
+    }
+
+    public byte addAndGet(final Number operand) {
+        this.value += operand.byteValue();
+        return this.value;
+    }
+
+    public byte getAndAdd(final byte operand) {
+        final byte last = this.value;
+        this.value += operand;
+        return last;
+    }
+
+    public byte getAndAdd(final Number operand) {
+        final byte last = this.value;
+        this.value += operand.byteValue();
+        return last;
+    }
+
+    public void increment() {
+        this.value++;
+    }
+
+    public byte incrementAndGet() {
+        this.value++;
+        return this.value;
+    }
+
+    public byte getAndIncrement() {
+        final byte last = this.value;
+        this.value++;
+        return last;
+    }
+
+    public void decrement() {
+        this.value--;
+    }
+
+    public byte decrementAndGet() {
+        this.value--;
+        return this.value;
+    }
+
+    public byte getAndDecrement() {
+        final byte last = this.value;
+        this.value--;
+        return last;
+    }
+
+    public void subtract(final byte operand) {
+        this.value -= operand;
+    }
+
+    public void subtract(final Number operand) {
+        this.value -= operand.byteValue();
+    }
+
+    public void setValue(final byte value) {
+        this.value = value;
+    }
+
+    public void setValue(final Number value) {
+        this.value = value.byteValue();
+    }
+
+    @Deprecated
+    public Byte getValue() {
+        return Byte.valueOf(this.value);
+    }
+
+    public Byte toByte() {
+        return Byte.valueOf(this.value);
+    }
+
+    /**
+     * Returns the primitive byte value.
+     *
+     * @return the primitive byte value
+     */
+    public byte byteValue() {
+        return this.value;
+    }
+}
