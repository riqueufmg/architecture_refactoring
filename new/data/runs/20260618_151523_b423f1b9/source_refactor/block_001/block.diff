+package org.jsoup.parser;
+
+/**
+ * Helper facade that concentrates parser configuration related convenience methods.
+ *
+ * This class wraps an existing ParserConfig and exposes the legacy convenience API
+ * that previously lived on {@link Parser}. Setter methods are chainable and return
+ * {@code this} for fluent configuration calls. All operations delegate directly to
+ * the underlying {@link ParserConfig} instance.
+ */
+public final class ParserConfigSupport {
+    private final ParserConfig config;
+
+    /**
+     * Create a new configuration helper that delegates to the provided ParserConfig.
+     * @param config the ParserConfig to delegate to
+     */
+    public ParserConfigSupport(ParserConfig config) {
+        this.config = config;
+    }
+
+    /**
+     * Check if parse error tracking is enabled.
+     * @return current track error state.
+     */
+    public boolean isTrackErrors() {
+        return config.isTrackErrors();
+    }
+
+    /**
+     * Enable or disable parse error tracking for the next parse.
+     * @param maxErrors the maximum number of errors to track. Set to 0 to disable.
+     * @return this support object, for chaining
+     */
+    public ParserConfigSupport setTrackErrors(int maxErrors) {
+        config.setTrackErrors(maxErrors);
+        return this;
+    }
+
+    /**
+     * Retrieve the parse errors, if any, from the last parse.
+     * @return list of parse errors, up to the size of the maximum errors tracked.
+     */
+    public ParseErrorList getErrors() {
+        return config.getErrors();
+    }
+
+    /**
+     * Test if position tracking is enabled. If it is, Nodes will have a Position to track
+     * where in the original input source they were created from.
+     * @return current track position setting
+     */
+    public boolean isTrackPosition() {
+        return config.isTrackPosition();
+    }
+
+    /**
+     * Enable or disable source position tracking. If enabled, Nodes will have a Position
+     * to track where in the original input source they were created from.
+     * @param trackPosition position tracking setting; {@code true} to enable
+     * @return this support object, for chaining
+     */
+    public ParserConfigSupport setTrackPosition(boolean trackPosition) {
+        config.setTrackPosition(trackPosition);
+        return this;
+    }
+
+    /**
+     * Update the ParseSettings of the underlying configuration to control the case
+     * sensitivity of tags and attributes.
+     * @param settings the new settings
+     * @return this support object, for chaining
+     */
+    public ParserConfigSupport settings(ParseSettings settings) {
+        config.settings(settings);
+        return this;
+    }
+
+    /**
+     * Gets the current ParseSettings from the underlying configuration.
+     * @return current ParseSettings
+     */
+    public ParseSettings settings() {
+        return config.settings();
+    }
+
+    /**
+     * Set the parser's maximum stack depth (maximum number of open elements).
+     * @param maxDepth maximum parser depth; must be >= 1
+     * @return this support object, for chaining
+     */
+    public ParserConfigSupport setMaxDepth(int maxDepth) {
+        config.setMaxDepth(maxDepth);
+        return this;
+    }
+
+    /**
+     * Get the maximum parser depth (maximum number of open elements).
+     * @return the current max parser depth
+     */
+    public int getMaxDepth() {
+        return config.getMaxDepth();
+    }
+
+    /**
+     * Set a custom TagSet to use for parsing. This gets copied by the underlying
+     * configuration so further parser activity will not mutate the caller's TagSet.
+     * @param tagSet the TagSet to use
+     * @return this support object, for chaining
+     */
+    public ParserConfigSupport tagSet(TagSet tagSet) {
+        config.tagSet(tagSet);
+        return this;
+    }
+
+    /**
+     * Get the current TagSet for parsing.
+     * @return the current TagSet
+     */
+    public TagSet tagSet() {
+        return config.tagSet();
+    }
+}
