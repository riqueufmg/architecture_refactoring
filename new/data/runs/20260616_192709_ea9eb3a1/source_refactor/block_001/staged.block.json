      ],
      "details": "Replace the explicit try { lock.lock(); return treeBuilder.parseFragment(fragment, context, baseUri, this); } finally { lock.unlock(); } in the public List<Node> parseFragmentInput(Reader fragment, @Nullable Element context, String baseUri) method with: return ParserUtils.withLock(lock, () -> treeBuilder.parseFragment(fragment, context, baseUri, this)); Keep method signature and visibility unchanged. No change to public API.",
      "risk": "low"
    },
