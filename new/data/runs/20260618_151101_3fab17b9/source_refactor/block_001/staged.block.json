  "id": 1,
  "goal": "Extract the static parsing/factory and convenience helper responsibilities from org.jsoup.parser.Parser into a new org.jsoup.parser.Parsers class. This clusters all public static parse/factory/unescape helper methods into a dedicated class, reducing the number of public methods on Parser and improving modularization.",
  "expected_impact": {
    "primary_metric": "public_methods",
    "public_methods_moved": 8,
    "total_methods_moved": 8,
    "loc_reduction_expected": "medium",
    "rationale": "The extraction moves the public static convenience methods (parse, parseFragment overloads, parseXmlFragment, parseBodyFragment, unescapeEntities, htmlParser, xmlParser) out of Parser into a new Parsers class. This reduces the public surface of Parser by 8 methods, reduces its total method count by 8, and centralizes factory/utility behaviour into a cohesive class, lowering Parser's LOC and responsibility concentration."
  },
