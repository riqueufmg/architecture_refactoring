  "id": 1,
  "goal": "Extract the deprecated Parser configuration wrapper API into a dedicated ParserConfigApi class to reduce the number of public methods on Parser and consolidate configuration-related responsibilities.",
  "expected_impact": {
    "primary_metric": "public_methods",
    "public_methods_moved": 11,
    "total_methods_moved": 11,
    "loc_reduction_expected": "medium",
