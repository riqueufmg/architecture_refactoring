+package org.apache.commons.lang3;
+
+/**
+ * Extraction of primitive-adaptation helpers for {@link BitField}.
+ *
+ * <p>
+ * This class centralizes implementations for byte/short adapters used by BitField. Methods are static and accept the necessary BitField state (mask and
+ * shiftCount) to avoid duplicating mutable state. This class is package-private to keep the API surface focused on {@link BitField}.
+ * </p>
+ */
+public final class BitFieldPrimitives {
+
+    private BitFieldPrimitives() {
+        // no instance
+    }
+
+    public static byte clearByte(final byte holder, final long mask) {
+        return (byte) (((long) holder) & ~mask);
+    }
+
+    public static short clearShort(final short holder, final long mask) {
+        return (short) (((long) holder) & ~mask);
+    }
+
+    public static byte setByte(final byte holder, final long mask) {
+        return (byte) (((long) holder) | mask);
+    }
+
+    public static byte setByteBoolean(final byte holder, final boolean flag, final long mask) {
+        return flag ? setByte(holder, mask) : clearByte(holder, mask);
+    }
+
+    public static short setShort(final short holder, final long mask) {
+        return (short) (((long) holder) | mask);
+    }
+
+    public static short setShortBoolean(final short holder, final boolean flag, final long mask) {
+        return flag ? setShort(holder, mask) : clearShort(holder, mask);
+    }
+
+    public static short getShortRawValue(final short holder, final long mask) {
+        return (short) ((((long) holder) & mask));
+    }
+
+    public static short getShortValue(final short holder, final int shiftCount, final long mask) {
+        return (short) ((((long) holder) & mask) >> shiftCount);
+    }
+
+    public static short setShortValue(final short holder, final short value, final int shiftCount, final long mask) {
+        final long res = (((long) holder) & ~mask) | ((((long) value) << shiftCount) & mask);
+        return (short) res;
+    }
+}
