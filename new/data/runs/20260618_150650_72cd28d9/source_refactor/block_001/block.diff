+package org.jsoup.parser;
+
+/**
+ * Convenience facade for parser configuration operations.
+ *
+ * This class wraps a ParserConfig and exposes legacy/configuration APIs that were previously
+ * surfaced directly on Parser. Methods that would previously return a Parser for chaining now
+ * return ParserConfiguration to allow chained configuration without requiring a Parser instance.
+ */
+public final class ParserConfiguration {
+    private final ParserConfig config;
+
+    public ParserConfiguration(ParserConfig config) {
+        this.config = config;
+    }
+
+    @Deprecated
+    public boolean isTrackErrors() {
+        return config.isTrackErrors();
+    }
+
+    /**
+     * Enable or disable parse error tracking for the next parse.
+     * @param maxErrors the maximum number of errors to track. Set to 0 to disable.
+     * @return this configuration instance, for chaining
+     */
+    public ParserConfiguration setTrackErrors(int maxErrors) {
+        config.setTrackErrors(maxErrors);
+        return this;
+    }
+
+    @Deprecated
+    public ParseErrorList getErrors() {
+        return config.getErrors();
+    }
+
+    @Deprecated
+    public boolean isTrackPosition() {
+        return config.isTrackPosition();
+    }
+
+    public ParserConfiguration setTrackPosition(boolean trackPosition) {
+        config.setTrackPosition(trackPosition);
+        return this;
+    }
+
+    /**
+     * Update the ParseSettings of this ParserConfig, to control the case sensitivity of tags and attributes.
+     * @param settings the new settings
+     * @return this configuration
+     */
+    public ParserConfiguration settings(ParseSettings settings) {
+        config.settings(settings);
+        return this;
+    }
+
+    @Deprecated
+    public ParseSettings settings() {
+        return config.settings();
+    }
+
+    public ParserConfiguration setMaxDepth(int maxDepth) {
+        config.setMaxDepth(maxDepth);
+        return this;
+    }
+
+    @Deprecated
+    public int getMaxDepth() {
+        return config.getMaxDepth();
+    }
+
+    public ParserConfiguration tagSet(TagSet tagSet) {
+        config.tagSet(tagSet);
+        return this;
+    }
+
+    @Deprecated
+    public TagSet tagSet() {
+        return config.tagSet();
+    }
+
+    // expose the underlying config if callers need to access lower-level APIs
+    public ParserConfig underlying() {
+        return config;
+    }
+}
