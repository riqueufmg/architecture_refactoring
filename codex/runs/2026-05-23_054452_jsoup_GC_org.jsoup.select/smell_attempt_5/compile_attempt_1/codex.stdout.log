aluator.java:822:    public static final class ContainsText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:849:    public static final class ContainsWholeText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:876:    public static final class ContainsWholeOwnText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:897:    public static final class ContainsData extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:918:    public static final class ContainsOwnText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:939:    public static final class Matches extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:968:    public static final class MatchesOwn extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:998:    public static final class MatchesWholeText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:1028:    public static final class MatchesWholeOwnText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:1060:    public static final class MatchText extends Evaluator {\nsrc/main/java/org/jsoup/select/Evaluator.java:1067:                System.err.println(\"WARNING: :matchText selector is deprecated and will be removed in jsoup 1.24.1. Use Element#selectNodes(String, Class) with selector ::textnode and class TextNode instead.\");\n","exit_code":0,"status":"completed"}}
