eByteArrayIndex(baout, ref, new int[] { 2, 4, 8, 16 });\n                // Check original data\n                byte[] baoutData = IOUtils.toByteArray(in);\n                assertEquals(8224, baoutData.length);\n                ByteArrayOutputStreamTestSupport.checkByteArrays(refData, baoutData);\n                // Check new data written after reset\n                try (InputStream in2 = baout.toInputStream()) {\n                    baoutData = IOUtils.toByteArray(in2);\n                }\n                refData = ref.toByteArray();\n                assertEquals(30, baoutData.length);\n                ByteArrayOutputStreamTestSupport.checkByteArrays(refData, baoutData);\n            }\n        }\n    }\n\n    @ParameterizedTest(name = \"[{index}] {0}\")\n    @MethodSource(\"baosFactories\")\n    void testWriteByte(final String baosName, final BAOSFactory<?> baosFactory) throws Exception {\n        int written;\n        // The ByteArrayOutputStream is initialized with 32 bytes to match\n        // the original more closely for this test.\n        try (AbstractByteArrayOutputStream<?> baout = baosFactory.newInstance(32); java.io.ByteArrayOutputStream ref = new java.io.ByteArrayOutputStream()) {\n            // First three writes\n            written = ByteArrayOutputStreamTestSupport.writeByte(baout, ref, new int[] { 4, 10, 22 });\n            assertEquals(36, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Another two writes to see if there are any bad effects after toByteArray()\n            written = ByteArrayOutputStreamTestSupport.writeByte(baout, ref, new int[] { 20, 12 });\n            assertEquals(32, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Now reset the streams\n            baout.reset();\n            ref.reset();\n            // Test again to see if reset() had any bad effects\n            written = ByteArrayOutputStreamTestSupport.writeByte(baout, ref, new int[] { 5, 47, 33, 60, 1, 0, 8 });\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Test the readFrom(InputStream) method\n            baout.reset();\n            written = baout.write(new ByteArrayInputStream(ref.toByteArray()));\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Write the commons Byte[]OutputStream to a java.io.Byte[]OutputStream\n            // and vice-versa to test the writeTo() method.\n            try (AbstractByteArrayOutputStream<?> baout1 = baosFactory.newInstance(32)) {\n                ref.writeTo(baout1);\n                final java.io.ByteArrayOutputStream ref1 = new java.io.ByteArrayOutputStream();\n                baout.writeTo(ref1);\n                ByteArrayOutputStreamTestSupport.checkStreams(baout1, ref1);\n                // Testing toString(String)\n                final String baoutString = baout.toString(\"ASCII\");\n                final String refString = ref.toString(\"ASCII\");\n                assertEquals(refString, baoutString, \"ASCII decoded String must be equal\");\n                // Make sure that empty ByteArrayOutputStreams really don't create garbage\n                // on toByteArray()\n                try (AbstractByteArrayOutputStream<?> baos1 = baosFactory.newInstance(); AbstractByteArrayOutputStream<?> baos2 = baosFactory.newInstance()) {\n                    assertSame(baos1.toByteArray(), baos2.toByteArray());\n                }\n            }\n        }\n    }\n\n    @ParameterizedTest(name = \"[{index}] {0}\")\n    @MethodSource(\"baosFactories\")\n    void testWriteByteArray(final String baosName, final BAOSFactory<?> baosFactory) throws Exception {\n        int written;\n        // The ByteArrayOutputStream is initialized with 32 bytes to match\n        // the original more closely for this test.\n        try (AbstractByteArrayOutputStream<?> baout = baosFactory.newInstance(32); java.io.ByteArrayOutputStream ref = new java.io.ByteArrayOutputStream()) {\n            // First three writes\n            written = ByteArrayOutputStreamTestSupport.writeByteArray(baout, ref, new int[] { 4, 10, 22 });\n            assertEquals(36, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Another two writes to see if there are any bad effects after toByteArray()\n            written = ByteArrayOutputStreamTestSupport.writeByteArray(baout, ref, new int[] { 20, 12 });\n            assertEquals(32, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Now reset the streams\n            baout.reset();\n            ref.reset();\n            // Test again to see if reset() had any bad effects\n            written = ByteArrayOutputStreamTestSupport.writeByteArray(baout, ref, new int[] { 5, 47, 33, 60, 1, 0, 8 });\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Test the readFrom(InputStream) method\n            baout.reset();\n            written = baout.write(new ByteArrayInputStream(ref.toByteArray()));\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Write the commons Byte[]OutputStream to a java.io.Byte[]OutputStream\n            // and vice-versa to test the writeTo() method.\n            try (AbstractByteArrayOutputStream<?> baout1 = baosFactory.newInstance(32)) {\n                ref.writeTo(baout1);\n                final java.io.ByteArrayOutputStream ref1 = new java.io.ByteArrayOutputStream();\n                baout.writeTo(ref1);\n                ByteArrayOutputStreamTestSupport.checkStreams(baout1, ref1);\n                // Testing toString(String)\n                final String baoutString = baout.toString(\"ASCII\");\n                final String refString = ref.toString(\"ASCII\");\n                assertEquals(refString, baoutString, \"ASCII decoded String must be equal\");\n                // Make sure that empty ByteArrayOutputStreams really don't create garbage\n                // on toByteArray()\n                try (AbstractByteArrayOutputStream<?> baos1 = baosFactory.newInstance(); AbstractByteArrayOutputStream<?> baos2 = baosFactory.newInstance()) {\n                    assertSame(baos1.toByteArray(), baos2.toByteArray());\n                }\n            }\n        }\n    }\n\n    @ParameterizedTest(name = \"[{index}] {0}\")\n    @MethodSource(\"baosFactories\")\n    void testWriteByteArrayIndex(final String baosName, final BAOSFactory<?> baosFactory) throws Exception {\n        int written;\n        // The ByteArrayOutputStream is initialized with 32 bytes to match\n        // the original more closely for this test.\n        try (AbstractByteArrayOutputStream<?> baout = baosFactory.newInstance(32); java.io.ByteArrayOutputStream ref = new java.io.ByteArrayOutputStream()) {\n            // First three writes\n            written = ByteArrayOutputStreamTestSupport.writeByteArrayIndex(baout, ref, new int[] { 4, 10, 22 });\n            assertEquals(36, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Another two writes to see if there are any bad effects after toByteArray()\n            written = ByteArrayOutputStreamTestSupport.writeByteArrayIndex(baout, ref, new int[] { 20, 12 });\n            assertEquals(32, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Now reset the streams\n            baout.reset();\n            ref.reset();\n            // Test again to see if reset() had any bad effects\n            written = ByteArrayOutputStreamTestSupport.writeByteArrayIndex(baout, ref, new int[] { 5, 47, 33, 60, 1, 0, 8 });\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Test the readFrom(InputStream) method\n            baout.reset();\n            written = baout.write(new ByteArrayInputStream(ref.toByteArray()));\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Write the commons Byte[]OutputStream to a java.io.Byte[]OutputStream\n            // and vice-versa to test the writeTo() method.\n            try (AbstractByteArrayOutputStream<?> baout1 = baosFactory.newInstance(32)) {\n                ref.writeTo(baout1);\n                final java.io.ByteArrayOutputStream ref1 = new java.io.ByteArrayOutputStream();\n                baout.writeTo(ref1);\n                ByteArrayOutputStreamTestSupport.checkStreams(baout1, ref1);\n                // Testing toString(String)\n                final String baoutString = baout.toString(\"ASCII\");\n                final String refString = ref.toString(\"ASCII\");\n                assertEquals(refString, baoutString, \"ASCII decoded String must be equal\");\n                // Make sure that empty ByteArrayOutputStreams really don't create garbage\n                // on toByteArray()\n                try (AbstractByteArrayOutputStream<?> baos1 = baosFactory.newInstance(); AbstractByteArrayOutputStream<?> baos2 = baosFactory.newInstance()) {\n                    assertSame(baos1.toByteArray(), baos2.toByteArray());\n                }\n            }\n        }\n    }\n\n    @ParameterizedTest(name = \"[{index}] {0}\")\n    @MethodSource(\"baosFactories\")\n    void testWriteStringCharset(final String baosName, final BAOSFactory<?> baosFactory) throws Exception {\n        int written;\n        // The ByteArrayOutputStream is initialized with 32 bytes to match\n        // the original more closely for this test.\n        try (AbstractByteArrayOutputStream<?> baout = baosFactory.newInstance(32); java.io.ByteArrayOutputStream ref = new java.io.ByteArrayOutputStream()) {\n            // First three writes\n            written = ByteArrayOutputStreamTestSupport.writeStringCharset(baout, ref, new int[] { 4, 10, 22 });\n            assertEquals(36, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Another two writes to see if there are any bad effects after toByteArray()\n            written = ByteArrayOutputStreamTestSupport.writeStringCharset(baout, ref, new int[] { 20, 12 });\n            assertEquals(32, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Now reset the streams\n            baout.reset();\n            ref.reset();\n            // Test again to see if reset() had any bad effects\n            written = ByteArrayOutputStreamTestSupport.writeStringCharset(baout, ref, new int[] { 5, 47, 33, 60, 1, 0, 8 });\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Test the readFrom(InputStream) method\n            baout.reset();\n            written = baout.write(new ByteArrayInputStream(ref.toByteArray()));\n            assertEquals(155, written);\n            ByteArrayOutputStreamTestSupport.checkStreams(baout, ref);\n            // Write the commons Byte[]OutputStream to a java.io.Byte[]OutputStream\n            // and vice-versa to test the writeTo() method.\n            try (AbstractByteArrayOutputStream<?> baout1 = baosFactory.newInstance(32)) {\n                ref.writeTo(baout1);\n                final java.io.ByteArrayOutputStream ref1 = new java.io.ByteArrayOutputStream();\n                baout.writeTo(ref1);\n                ByteArrayOutputStreamTestSupport.checkStreams(baout1, ref1);\n                // Testing toString(String)\n                final String baoutString = baout.toString(\"ASCII\");\n                final String refString = ref.toString(\"ASCII\");\n                assertEquals(refString, baoutString, \"ASCII decoded String must be equal\");\n                // Make sure that empty ByteArrayOutputStreams really don't create garbage\n                // on toByteArray()\n                try (AbstractByteArrayOutputStream<?> baos1 = baosFactory.newInstance(); AbstractByteArrayOutputStream<?> baos2 = baosFactory.newInstance()) {\n                    assertSame(baos1.toByteArray(), baos2.toByteArray());\n                }\n            }\n        }\n    }\n\n    @ParameterizedTest(name = \"[{index}] {0}\")\n    @MethodSource(\"baosFactories\")\n    void testWriteZero(final String baosName, final BAOSFactory<?> baosFactory) throws IOException {\n        try (AbstractByteArrayOutputStream<?> baout = baosFactory.newInstance()) {\n            baout.write(IOUtils.EMPTY_BYTE_ARRAY, 0, 0);\n            assertTrue(true, \"Dummy\");\n        }\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByte(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int count) {\n        if (count > ASCII_DATA.length) {\n            throw new IllegalArgumentException(\"Requesting too many bytes\");\n        }\n        if (count == 0) {\n            baout.write(100);\n            ref.write(100);\n            return 1;\n        }\n        for (int i = 0; i < count; i++) {\n            baout.write(ASCII_DATA[i]);\n            ref.write(ASCII_DATA[i]);\n        }\n        return count;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByte(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int[] instructions) {\n        int written = 0;\n        for (final int instruction : instructions) {\n            written += ByteArrayOutputStreamTestSupport.writeByte(baout, ref, instruction);\n        }\n        return written;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByteArray(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int count) throws IOException {\n        if (count > ASCII_DATA.length) {\n            throw new IllegalArgumentException(\"Requesting too many bytes\");\n        }\n        if (count == 0) {\n            // length 1 data\n            baout.write(new byte[] { 100 });\n            ref.write(new byte[] { 100 });\n            return 1;\n        }\n        baout.write(Arrays.copyOf(ASCII_DATA, count));\n        ref.write(Arrays.copyOf(ASCII_DATA, count));\n        return count;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByteArray(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int[] instructions)\n            throws IOException {\n        int written = 0;\n        for (final int instruction : instructions) {\n            written += ByteArrayOutputStreamTestSupport.writeByteArray(baout, ref, instruction);\n        }\n        return written;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByteArrayIndex(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int count) {\n        if (count > ASCII_DATA.length) {\n            throw new IllegalArgumentException(\"Requesting too many bytes\");\n        }\n        if (count == 0) {\n            // length 1 data\n            baout.write(100);\n            ref.write(100);\n            return 1;\n        }\n        baout.write(ASCII_DATA, 0, count);\n        ref.write(ASCII_DATA, 0, count);\n        return count;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeByteArrayIndex(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int[] instructions) {\n        int written = 0;\n        for (final int instruction : instructions) {\n            written += ByteArrayOutputStreamTestSupport.writeByteArrayIndex(baout, ref, instruction);\n        }\n        return written;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeStringCharset(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int count) throws IOException {\n        if (count > ASCII_DATA.length) {\n            throw new IllegalArgumentException(\"Requesting too many bytes\");\n        }\n        if (count == 0) {\n            // length 1 data\n            final String data = \"a\";\n            baout.write(data, StandardCharsets.UTF_8);\n            ref.write(data.getBytes(StandardCharsets.UTF_8));\n            return 1;\n        }\n        final String data = new String(ASCII_DATA, StandardCharsets.UTF_8).substring(0, count);\n        assertEquals(count, data.length(), () -> String.format(\"[%,d]:'%s'\", count, data));\n        baout.write(data, StandardCharsets.UTF_8);\n        final byte[] bytes = data.getBytes(StandardCharsets.UTF_8);\n        // For now, test assumes 1-1 size mapping from chars to bytes.\n        assertEquals(count, bytes.length, () -> String.format(\"[%,d]:'%s'\", count, data));\n        ref.write(bytes);\n        return count;\n    }\n\n    private int ByteArrayOutputStreamTestSupport.writeStringCharset(final AbstractByteArrayOutputStream<?> baout, final java.io.ByteArrayOutputStream ref, final int[] instructions)\n            throws IOException {\n        int written = 0;\n        for (final int instruction : instructions) {\n            written += ByteArrayOutputStreamTestSupport.writeStringCharset(baout, ref, instruction);\n        }\n        return written;\n    }\n}\n","exit_code":0,"status":"completed"}}
