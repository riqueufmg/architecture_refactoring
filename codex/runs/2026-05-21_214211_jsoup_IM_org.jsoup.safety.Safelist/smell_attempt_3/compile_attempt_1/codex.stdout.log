{"type":"item.completed","item":{"id":"item_7","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' src/main/java/org/jsoup/safety/SafelistAttributePolicy.java\"","aggregated_output":"package org.jsoup.safety;\n\nimport org.jsoup.nodes.Attribute;\nimport org.jsoup.nodes.Element;\n\nimport java.util.Map;\nimport java.util.Set;\n\nimport static org.jsoup.internal.Normalizer.lowerCase;\n\nfinal class SafelistAttributePolicy {\n    private static final String All = \":all\";\n    private static final SafelistValues.TagName AllTag = SafelistValues.TagName.valueOf(All);\n\n    private final Map<SafelistValues.TagName, Set<SafelistValues.AttributeKey>> attributes;\n    private final Map<SafelistValues.TagName, Map<SafelistValues.AttributeKey, SafelistValues.AttributeValue>> enforcedAttributes;\n    private final Map<SafelistValues.TagName, Map<SafelistValues.AttributeKey, Set<SafelistValues.Protocol>>> protocols;\n\n    SafelistAttributePolicy(\n        Map<SafelistValues.TagName, Set<SafelistValues.AttributeKey>> attributes,\n        Map<SafelistValues.TagName, Map<SafelistValues.AttributeKey, SafelistValues.AttributeValue>> enforcedAttributes,\n        Map<SafelistValues.TagName, Map<SafelistValues.AttributeKey, Set<SafelistValues.Protocol>>> protocols\n    ) {\n        this.attributes = attributes;\n        this.enforcedAttributes = enforcedAttributes;\n        this.protocols = protocols;\n    }\n\n    boolean isSafeAttribute(String tagName, Element el, Attribute attr) {\n        SafelistValues.TagName tag = SafelistValues.TagName.valueOf(tagName);\n        SafelistValues.AttributeKey key = SafelistValues.AttributeKey.valueOf(attr.getKey());\n\n        Set<SafelistValues.AttributeKey> okSet = attributes.get(tag);\n        if (okSet != null && okSet.contains(key)) {\n            if (protocols.containsKey(tag)) {\n                Map<SafelistValues.AttributeKey, Set<SafelistValues.Protocol>> attrProts = protocols.get(tag);\n                return !attrProts.containsKey(key) || isSafeProtocol(getProtocolValue(el, attr), attrProts.get(key));\n            } else {\n                return true;\n            }\n        }\n        Map<SafelistValues.AttributeKey, SafelistValues.AttributeValue> enforcedSet = enforcedAttributes.get(tag);\n        if (enforcedSet != null && enforcedSet.containsKey(key)) {\n            return enforcedSet.get(key).equals(SafelistValues.AttributeValue.valueOf(attr.getValue()));\n        }\n        return !tagName.equals(All) && isSafeAttribute(All, el, attr);\n    }\n\n    boolean shouldAbsUrl(String tagName, String attrKey, boolean preserveRelativeLinks) {\n        if (preserveRelativeLinks) return false;\n        return shouldAbsUrl(SafelistValues.TagName.valueOf(tagName), SafelistValues.AttributeKey.valueOf(attrKey));\n    }\n\n    private String getProtocolValue(Element el, Attribute attr) {\n        String value = el.absUrl(attr.getKey());\n        if (value.isEmpty()) value = attr.getValue();\n        return value;\n    }\n\n    private boolean isSafeProtocol(String value, Set<SafelistValues.Protocol> protocols) {\n        for (SafelistValues.Protocol protocol : protocols) {\n            String prot = protocol.toString();\n\n            if (prot.equals(\"#\")) {\n                if (isValidAnchor(value)) {\n                    return true;\n                } else {\n                    continue;\n                }\n            }\n\n            prot += \":\";\n\n            if (lowerCase(value).startsWith(prot)) {\n                return true;\n            }\n        }\n        return false;\n    }\n\n    private boolean shouldAbsUrl(SafelistValues.TagName tag, SafelistValues.AttributeKey key) {\n        Set<SafelistValues.AttributeKey> allowedAttrs = attributes.get(tag);\n        if (allowedAttrs != null && allowedAttrs.contains(key)) {\n            Map<SafelistValues.AttributeKey, Set<SafelistValues.Protocol>> protocolsByAttr = protocols.get(tag);\n            return protocolsByAttr != null && protocolsByAttr.containsKey(key);\n        }\n\n        Map<SafelistValues.AttributeKey, SafelistValues.AttributeValue> enforcedAttrs = enforcedAttributes.get(tag);\n        if (enforcedAttrs != null && enforcedAttrs.containsKey(key)) return false;\n\n        return !tag.equals(AllTag) && shouldAbsUrl(AllTag, key);\n    }\n\n    private static boolean isValidAnchor(String value) {\n        return value.startsWith(\"#\") && !value.matches(\".*\\\\s.*\");\n    }\n}\n","exit_code":0,"status":"completed"}}
