ector.collect(new Evaluator.Matches(pattern), (Element) this);\n    }\n\n    public Elements getElementsMatchingText(String regex) {\n        Regex pattern;\n        try {\n            pattern = Regex.compile(regex);\n        } catch (PatternSyntaxException e) {\n            throw new IllegalArgumentException(\"Pattern syntax error: \" + regex, e);\n        }\n        return Collector.collect(new Evaluator.Matches(pattern), (Element) this);\n    }\n\n    public Elements getElementsMatchingOwnText(Pattern pattern) {\n        return Collector.collect(new Evaluator.MatchesOwn(pattern), (Element) this);\n    }\n\n    public Elements getElementsMatchingOwnText(String regex) {\n        Regex pattern;\n        try {\n            pattern = Regex.compile(regex);\n        } catch (PatternSyntaxException e) {\n            throw new IllegalArgumentException(\"Pattern syntax error: \" + regex, e);\n        }\n        return Collector.collect(new Evaluator.MatchesOwn(pattern), (Element) this);\n    }\n\n    public Elements getAllElements() {\n        return Collector.collect(new Evaluator.AllElements(), (Element) this);\n    }\n}\n","exit_code":0,"status":"completed"}}
