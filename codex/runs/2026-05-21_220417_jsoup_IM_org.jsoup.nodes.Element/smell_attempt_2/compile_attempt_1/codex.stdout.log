turn el;\n            el = el.parent();\n        } while (el != null);\n        return null;\n    }\n\n    public Elements selectXpath(String xpath) {\n        return new Elements(NodeUtils.selectXpath(xpath, (Element) this, Element.class));\n    }\n\n    public <T extends Node> List<T> selectXpath(String xpath, Class<T> nodeType) {\n        return NodeUtils.selectXpath(xpath, (Element) this, nodeType);\n    }\n\n    public Elements getElementsByTag(String tagName) {\n        Validate.notEmpty(tagName);\n        tagName = Normalizer.normalize(tagName);\n        return Collector.collect(new Evaluator.Tag(tagName), (Element) this);\n    }\n\n    public @Nullable Element getElementById(String id) {\n        Validate.notEmpty(id);\n        return Collector.findFirst(new Evaluator.Id(id), (Element) this);\n    }\n\n    public Elements getElementsByClass(String className) {\n        Validate.notEmpty(className);\n        return Collector.collect(new Evaluator.Class(className), (Element) this);\n    }\n\n    public Elements getElementsByAttribute(String key) {\n        Validate.notEmpty(key);\n        key = key.trim();\n        return Collector.collect(new Evaluator.Attribute(key), (Element) this);\n    }\n\n    public Elements getElementsByAttributeStarting(String keyPrefix) {\n        Validate.notEmpty(keyPrefix);\n        keyPrefix = keyPrefix.trim();\n        return Collector.collect(new Evaluator.AttributeStarting(keyPrefix), (Element) this);\n    }\n\n    public Elements getElementsByAttributeValue(String key, String value) {\n        return Collector.collect(new Evaluator.AttributeWithValue(key, value), (Element) this);\n    }\n\n    public Elements getElementsByAttributeValueNot(String key, String value) {\n        return Collector.collect(new Evaluator.AttributeWithValueNot(key, value), (Element) this);\n    }\n\n    public Elements getElementsByAttributeValueStarting(String key, String valuePrefix) {\n        return Collector.collect(new Evaluator.AttributeWithVa