{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' src/main/java/org/jsoup/nodes/ElementTreeOps.java\"","aggregated_output":"package org.jsoup.nodes;\n\nimport org.jsoup.helper.Validate;\nimport org.jsoup.parser.Parser;\n\nimport java.util.Collection;\nimport java.util.List;\n\n/**\n * Structural tree mutation and child-construction operations for {@link Element}.\n */\nabstract class ElementTreeOps extends ElementTextOps {\n    public Element appendChild(Node child) {\n        Validate.notNull(child);\n\n        // was - Node#addChildren(child). short-circuits an array create and a loop.\n        reparentChild(child);\n        ensureChildNodes();\n        Element self = (Element) this;\n        self.childNodes.add(child);\n        child.setSiblingIndex(self.childNodes.size() - 1);\n        return self;\n    }\n\n    public Element appendChildren(Collection<? extends Node> children) {\n        insertChildren(-1, children);\n        return (Element) this;\n    }\n\n    public Element appendTo(Element parent) {\n        Validate.notNull(parent);\n        parent.appendChild((Element) this);\n        return (Element) this;\n    }\n\n    public Element prependChild(Node child) {\n        Validate.notNull(child);\n\n        addChildren(0, child);\n        return (Element) this;\n    }\n\n    public Element prependChildren(Collection<? extends Node> children) {\n        insertChildren(0, children);\n        return (Element) this;\n    }\n\n    public Element insertChildren(int index, Collection<? extends Node> children) {\n        Validate.notNull(children, \"Children collection to be inserted must not be null.\");\n        int currentSize = childNodeSize();\n        if (index < 0) index += currentSize + 1; // roll around\n        Validate.isTrue(index >= 0 && index <= currentSize, \"Insert position out of bounds.\");\n        addChildren(index, children.toArray(new Node[0]));\n        return (Element) this;\n    }\n\n    public Element insertChildren(int index, Node... children) {\n        Validate.notNull(children, \"Children collection to be inserted must not be null.\");\n        int currentSize = childNodeSize();\n        if (index < 0) index += currentSize + 1; // roll around\n        Validate.isTrue(index >= 0 && index <= currentSize, \"Insert position out of bounds.\");\n\n        addChildren(index, children);\n        return (Element) this;\n    }\n\n    public Element appendElement(String tagName) {\n        Element self = (Element) this;\n        return appendElement(tagName, self.tag.namespace());\n    }\n\n    public Element appendElement(String tagName, String namespace) {\n        Parser parser = NodeUtils.parser((Element) this);\n        Element child = new Element(parser.tagSet().valueOf(tagName, namespace, parser.settings()), baseUri());\n        appendChild(child);\n        return child;\n    }\n\n    public Element prependElement(String tagName) {\n        Element self = (Element) this;\n        return prependElement(tagName, self.tag.namespace());\n    }\n\n    public Element prependElement(String tagName, String namespace) {\n        Parser parser = NodeUtils.parser((Element) this);\n        Element child = new Element(parser.tagSet().valueOf(tagName, namespace, parser.settings()), baseUri());\n        prependChild(child);\n        return child;\n    }\n\n    public Element appendText(String text) {\n        Validate.notNull(text);\n        TextNode node = new TextNode(text);\n        appendChild(node);\n        return (Element) this;\n    }\n\n    public Element prependText(String text) {\n        Validate.notNull(text);\n        TextNode node = new TextNode(text);\n        prependChild(node);\n        return (Element) this;\n    }\n\n    public Element append(String html) {\n        Validate.notNull(html);\n        List<Node> nodes = NodeUtils.parser((Element) this).parseFragmentInput(html, (Element) this, baseUri());\n        addChildren(nodes.toArray(new Node[0]));\n        return (Element) this;\n    }\n\n    public Element prepend(String html) {\n        Validate.notNull(html);\n        List<Node> nodes = NodeUtils.parser((Element) this).parseFragmentInput(html, (Element) this, baseUri());\n        addChildren(0, nodes.toArray(new Node[0]));\n        return (Element) this;\n    }\n\n    @Override\n    public Element before(String html) {\n        return (Element) super.before(html);\n    }\n\n    @Override\n    public Element before(Node node) {\n        return (Element) super.before(node);\n    }\n\n    @Override\n    public Element after(String html) {\n        return (Element) super.after(html);\n    }\n\n    @Override\n    public Element after(Node node) {\n        return (Element) super.after(node);\n    }\n\n    @Override\n    public Element empty() {\n        Element self = (Element) this;\n        int size = self.childNodes.size();\n        for (int i = 0; i < size; i++)\n            self.childNodes.get(i).parentNode = null;\n        self.childNodes.clear();\n        return self;\n    }\n\n    @Override\n    public Element wrap(String html) {\n        return (Element) super.wrap(html);\n    }\n}\n","exit_code":0,"status":"completed"}}
