{"type":"item.completed","item":{"id":"item_22","type":"command_execution","command":"/bin/bash -lc \"nl -ba src/main/java/org/jsoup/nodes/Attributes.java | sed -n '1,240p'\"","aggregated_output":"     1\tpackage org.jsoup.nodes;\n     2\t\n     3\timport org.jsoup.helper.Validate;\n     4\timport org.jspecify.annotations.Nullable;\n     5\t\n     6\timport java.util.Arrays;\n     7\timport java.util.Objects;\n     8\t\n     9\t/**\n    10\t * The attributes of an Element.\n    11\t * <p>\n    12\t * During parsing, attributes in with the same name in an element are deduplicated, according to the configured parser's\n    13\t * attribute case-sensitive setting. It is possible to have duplicate attributes subsequently if\n    14\t * {@link #add(String, String)} vs {@link #put(String, String)} is used.\n    15\t * </p>\n    16\t * <p>\n    17\t * Attribute name and value comparisons are generally <b>case sensitive</b>. By default for HTML, attribute names are\n    18\t * normalized to lower-case on parsing. That means you should use lower-case strings when referring to attributes by\n    19\t * name.\n    20\t * </p>\n    21\t *\n    22\t * @author Jonathan Hedley, jonathan@hedley.net\n    23\t */\n    24\tpublic class Attributes extends AttributesMetadataSupport implements Iterable<Attribute>, Cloneable {\n    25\t    // The Attributes object is only created on the first use of an attribute; the Element will just have a null\n    26\t    // Attribute slot otherwise\n    27\t\n    28\t    static final char InternalPrefix = '/'; // Indicates an internal key. Can't be set via HTML. (It could be set via accessor, but not too worried about that. Suppressed from list, iter, size.)\n    29\t    protected static final String dataPrefix = \"data-\"; // data attributes\n    30\t    private static final String EmptyString = \"\";\n    31\t\n    32\t    // manages the key/val arrays\n    33\t    private static final int InitialCapacity = 3; // sampling found mean count when attrs present = 1.49; 1.08 overall. 2.6:1 don't have any attrs.\n    34\t    private static final int GrowthFactor = 2;\n    35\t    static final int NotFound = -1;\n    36\t\n    37\t    // the number of instance fields is kept as low as possible giving an object size of 24 bytes\n    38\t    int size = 0; // number of slots used (not total capacity, which is keys.length). Package visible for actual size (incl internal)\n    39\t    @Nullable String[] keys = new String[InitialCapacity]; // keys is not null, but contents may be. Same for vals\n    40\t    @Nullable Object[] vals = new Object[InitialCapacity]; // Genericish: all non-internal attribute values must be Strings and are cast on access.\n    41\t    // todo - make keys iterable without creating Attribute objects\n    42\t\n    43\t    // check there's room for more\n    44\t    void checkCapacity(int minNewSize) {\n    45\t        Validate.isTrue(minNewSize >= size);\n    46\t        int curCap = keys.length;\n    47\t        if (curCap >= minNewSize)\n    48\t            return;\n    49\t        int newCap = curCap >= InitialCapacity ? size * GrowthFactor : InitialCapacity;\n    50\t        if (minNewSize > newCap)\n    51\t            newCap = minNewSize;\n    52\t\n    53\t        keys = Arrays.copyOf(keys, newCap);\n    54\t        vals = Arrays.copyOf(vals, newCap);\n    55\t    }\n    56\t\n    57\t    int indexOfKey(String key) {\n    58\t        Validate.notNull(key);\n    59\t        for (int i = 0; i < size; i++) {\n    60\t            if (key.equals(keys[i]))\n    61\t                return i;\n    62\t        }\n    63\t        return NotFound;\n    64\t    }\n    65\t\n    66\t    int visibleIndexOfKey(String key) {\n    67\t        Validate.notNull(key);\n    68\t        return AttributesMetadata.visibleIndexOfKey(this, key);\n    69\t    }\n    70\t\n    71\t    private int indexOfKeyIgnoreCase(String key) {\n    72\t        Validate.notNull(key);\n    73\t        for (int i = 0; i < size; i++) {\n    74\t            if (key.equalsIgnoreCase(keys[i]))\n    75\t                return i;\n    76\t        }\n    77\t        return NotFound;\n    78\t    }\n    79\t\n    80\t    // we track boolean attributes as null in values - they're just keys. so returns empty for consumers\n    81\t    // casts to String, so only for non-internal attributes\n    82\t    static String checkNotNull(@Nullable Object val) {\n    83\t        return val == null ? EmptyString : (String) val;\n    84\t    }\n    85\t\n    86\t    /**\n    87\t     Get an attribute value by key.\n    88\t     @param key the (case-sensitive) attribute key\n    89\t     @return the attribute value if set; or empty string if not set (or a boolean attribute).\n    90\t     @see #hasKey(String)\n    91\t     */\n    92\t    public String get(String key) {\n    93\t        int i = indexOfKey(key);\n    94\t        return i == NotFound ? EmptyString : checkNotNull(vals[i]);\n    95\t    }\n    96\t\n    97\t    /**\n    98\t     Get an Attribute by key. The Attribute will remain connected to these Attributes, so changes made via\n    99\t     {@link Attribute#setKey(String)}, {@link Attribute#setValue(String)} etc will cascade back to these Attributes and\n   100\t     their owning Element.\n   101\t     @param key the (case-sensitive) attribute key\n   102\t     @return the Attribute for this key, or null if not present.\n   103\t     @since 1.17.2\n   104\t     */\n   105\t    @Nullable public Attribute attribute(String key) {\n   106\t        int i = indexOfKey(key);\n   107\t        return i == NotFound ? null : new Attribute(key, checkNotNull(vals[i]), this);\n   108\t    }\n   109\t\n   110\t    /**\n   111\t     * Get an attribute's value by case-insensitive key\n   112\t     * @param key the attribute name\n   113\t     * @return the first matching attribute value if set; or empty string if not set (ora boolean attribute).\n   114\t     */\n   115\t    public String getIgnoreCase(String key) {\n   116\t        int i = indexOfKeyIgnoreCase(key);\n   117\t        return i == NotFound ? EmptyString : checkNotNull(vals[i]);\n   118\t    }\n   119\t\n   120\t    /**\n   121\t     * Adds a new attribute. Will produce duplicates if the key already exists.\n   122\t     * @see Attributes#put(String, String)\n   123\t     */\n   124\t    public Attributes add(String key, @Nullable String value) {\n   125\t        addObject(key, value);\n   126\t        return this;\n   127\t    }\n   128\t\n   129\t    void addObject(String key, @Nullable Object value) {\n   130\t        checkCapacity(size + 1);\n   131\t        keys[size] = key;\n   132\t        vals[size] = value;\n   133\t        size++;\n   134\t    }\n   135\t\n   136\t    /**\n   137\t     * Set a new attribute, or replace an existing one by key.\n   138\t     * @param key case sensitive attribute key (not null)\n   139\t     * @param value attribute value (which can be null, to set a true boolean attribute)\n   140\t     * @return these attributes, for chaining\n   141\t     */\n   142\t    public Attributes put(String key, @Nullable String value) {\n   143\t        Validate.notNull(key);\n   144\t        int i = indexOfKey(key);\n   145\t        if (i != NotFound)\n   146\t            vals[i] = value;\n   147\t        else\n   148\t            addObject(key, value);\n   149\t        return this;\n   150\t    }\n   151\t\n   152\t    void putIgnoreCase(String key, @Nullable String value) {\n   153\t        int i = indexOfKeyIgnoreCase(key);\n   154\t        if (i != NotFound) {\n   155\t            vals[i] = value;\n   156\t            String old = keys[i];\n   157\t            assert old != null;\n   158\t            if (!old.equals(key))\n   159\t                keys[i] = key;\n   160\t        }\n   161\t        else\n   162\t            addObject(key, value);\n   163\t    }\n   164\t\n   165\t    /**\n   166\t     * Set a new boolean attribute. Removes the attribute if the value is false.\n   167\t     * @param key case <b>insensitive</b> attribute key\n   168\t     * @param value attribute value\n   169\t     * @return these attributes, for chaining\n   170\t     */\n   171\t    public Attributes put(String key, boolean value) {\n   172\t        if (value)\n   173\t            putIgnoreCase(key, null);\n   174\t        else\n   175\t            remove(key);\n   176\t        return this;\n   177\t    }\n   178\t\n   179\t    /**\n   180\t     Set a new attribute, or replace an existing one by key.\n   181\t     @param attribute attribute with case-sensitive key\n   182\t     @return these attributes, for chaining\n   183\t     */\n   184\t    public Attributes put(Attribute attribute) {\n   185\t        Validate.notNull(attribute);\n   186\t        put(attribute.getKey(), attribute.getValue());\n   187\t        attribute.parent = this;\n   188\t        return this;\n   189\t    }\n   190\t\n   191\t    // removes and shifts up\n   192\t    @SuppressWarnings(\"AssignmentToNull\")\n   193\t    void remove(int index) {\n   194\t        Validate.isFalse(index >= size);\n   195\t        AttributesMetadata.onRemoveSlot(this, index);\n   196\t\n   197\t        int shifted = size - index - 1;\n   198\t        if (shifted > 0) {\n   199\t            System.arraycopy(keys, index + 1, keys, index, shifted);\n   200\t            System.arraycopy(vals, index + 1, vals, index, shifted);\n   201\t        }\n   202\t        size--;\n   203\t        keys[size] = null;\n   204\t        vals[size] = null;\n   205\t    }\n   206\t\n   207\t    /**\n   208\t     Remove an attribute by key. <b>Case sensitive.</b>\n   209\t     @param key attribute key to remove\n   210\t     */\n   211\t    public void remove(String key) {\n   212\t        int i = indexOfKey(key);\n   213\t        if (i != NotFound)\n   214\t            remove(i);\n   215\t    }\n   216\t\n   217\t    /**\n   218\t     Remove an attribute by key. <b>Case insensitive.</b>\n   219\t     @param key attribute key to remove\n   220\t     */\n   221\t    public void removeIgnoreCase(String key) {\n   222\t        int i = indexOfKeyIgnoreCase(key);\n   223\t        if (i != NotFound)\n   224\t            remove(i);\n   225\t    }\n   226\t\n   227\t    /**\n   228\t     Tests if these attributes contain an attribute with this key.\n   229\t     @param key case-sensitive key to check for\n   230\t     @return true if key exists, false otherwise\n   231\t     */\n   232\t    public boolean hasKey(String key) {\n   233\t        return indexOfKey(key) != NotFound;\n   234\t    }\n   235\t\n   236\t    /**\n   237\t     Tests if these attributes contain an attribute with this key.\n   238\t     @param key key to check for\n   239\t     @return true if key exists, false otherwise\n   240\t     */\n","exit_code":0,"status":"completed"}}
