{"type":"item.completed","item":{"id":"item_8","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,340p' src/main/java/org/jsoup/nodes/AttributesMetadata.java\"","aggregated_output":"package org.jsoup.nodes;\n\nimport org.jsoup.internal.SharedConstants;\nimport org.jsoup.parser.ParseSettings;\nimport org.jspecify.annotations.Nullable;\n\nimport java.util.HashMap;\nimport java.util.Map;\n\nimport static org.jsoup.nodes.Range.AttributeRange.UntrackedAttr;\n\nfinal class AttributesMetadata {\n    private AttributesMetadata() {}\n\n    @SuppressWarnings(\"unchecked\")\n    static Map<String, Object> userData(Attributes attributes) {\n        final Map<String, Object> userData;\n        int i = attributes.indexOfKey(SharedConstants.UserDataKey);\n        if (i == Attributes.NotFound) {\n            userData = new HashMap<>();\n            attributes.addObject(SharedConstants.UserDataKey, userData);\n        } else {\n            userData = (Map<String, Object>) attributes.vals[i];\n        }\n        assert userData != null;\n        return userData;\n    }\n\n    static boolean hasUserData(Attributes attributes) {\n        return attributes.hasKey(SharedConstants.UserDataKey);\n    }\n\n    @Nullable\n    static Object userData(Attributes attributes, String key) {\n        if (!hasUserData(attributes)) return null;\n        return userData(attributes).get(key);\n    }\n\n    static Attributes userData(Attributes attributes, String key, @Nullable Object value) {\n        if (value == null && !attributes.hasKey(SharedConstants.UserDataKey)) return attributes;\n        Map<String, Object> userData = userData(attributes);\n        if (value == null) userData.remove(key);\n        else userData.put(key, value);\n        return attributes;\n    }\n\n    static Range.@Nullable Spans spans(Attributes attributes) {\n        int i = attributes.indexOfKey(SharedConstants.RangeSpansKey);\n        return i == Attributes.NotFound ? null : (Range.Spans) attributes.vals[i];\n    }\n\n    static Range.Spans ensureSpans(Attributes attributes) {\n        Range.Spans rangeSpans = spans(attributes);\n        if (rangeSpans == null) {\n            rangeSpans = new Range.Spans();\n            attributes.addObject(SharedConstants.RangeSpansKey, rangeSpans);\n        }\n        return rangeSpans;\n    }\n\n    static void putSpans(Attributes attributes, Range.Spans rangeSpans) {\n        int i = attributes.indexOfKey(SharedConstants.RangeSpansKey);\n        if (i == Attributes.NotFound)\n            attributes.addObject(SharedConstants.RangeSpansKey, rangeSpans);\n        else\n            attributes.vals[i] = rangeSpans;\n    }\n\n    static Range.AttributeRange sourceRange(Attributes attributes, String key) {\n        int index = visibleIndexOfKey(attributes, key);\n        if (index == Attributes.NotFound) return UntrackedAttr;\n        Range.Spans rangeSpans = spans(attributes);\n        return rangeSpans != null ? rangeSpans.attributeRange(index) : UntrackedAttr;\n    }\n\n    static void onRemoveSlot(Attributes attributes, int index) {\n        Range.Spans rangeSpans = spans(attributes);\n        if (rangeSpans != null && !Attributes.isInternalKey(attributes.keys[index]))\n            rangeSpans.removeAttributeRange(visibleIndex(attributes, index));\n    }\n\n    @SuppressWarnings(\"unchecked\")\n    static void copyToClone(Attributes source, Attributes clone) {\n        int i = source.indexOfKey(SharedConstants.UserDataKey);\n        if (i != Attributes.NotFound)\n            clone.vals[i] = new HashMap<>((Map<String, Object>) source.vals[i]);\n\n        i = source.indexOfKey(SharedConstants.RangeSpansKey);\n        if (i != Attributes.NotFound)\n            clone.vals[i] = ((Range.Spans) source.vals[i]).copy();\n    }\n\n    static int visibleIndexOfKey(Attributes attributes, String key) {\n        int visible = 0;\n        for (int i = 0; i < attributes.size; i++) {\n            String attrKey = attributes.keys[i];\n            if (Attributes.isInternalKey(attrKey))\n                continue;\n            if (key.equals(attrKey))\n                return visible;\n            visible++;\n        }\n        return Attributes.NotFound;\n    }\n\n    private static int visibleIndex(Attributes attributes, int index) {\n        int visible = 0;\n        for (int i = 0; i < index; i++) {\n            if (!Attributes.isInternalKey(attributes.keys[i]))\n                visible++;\n        }\n        return visible;\n    }\n}\n","exit_code":0,"status":"completed"}}
