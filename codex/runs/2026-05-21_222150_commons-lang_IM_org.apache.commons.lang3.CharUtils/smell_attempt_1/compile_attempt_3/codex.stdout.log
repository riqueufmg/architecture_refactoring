aLower(final char ch) {\n        return ch >= 'a' && ch <= 'z';\n    }\n\n    /**\n     * Tests whether the character is ASCII alphanumeric.\n     *\n     * @param ch the character to test.\n     * @return true if the character is an ASCII letter or digit.\n     */\n    static boolean isAsciiAlphanumeric(final char ch) {\n        return isAsciiAlpha(ch) || isAsciiNumeric(ch);\n    }\n\n    /**\n     * Tests whether the character is ASCII upper-case alphabetic.\n     *\n     * @param ch the character to test.\n     * @return true if the character is in the range {@code 'A'} to {@code 'Z'}.\n     */\n    static boolean isAsciiAlphaUpper(final char ch) {\n        return ch >= 'A' && ch <= 'Z';\n    }\n\n    /**\n     * Tests whether the character is an ASCII control character.\n     *\n     * @param ch the character to test.\n     * @return true if the character is below 32 or equal to 127.\n     */\n    static boolean isAsciiControl(final char ch) {\n        return ch < 32 || ch == 127;\n    }\n\n    /**\n     * Tests whether the character is ASCII numeric.\n     *\n     * @param ch the character to test.\n     * @return true if the character is in the range {@code '0'} to {@code '9'}.\n     */\n    static boolean isAsciiNumeric(final char ch) {\n        return ch >= '0' && ch <= '9';\n    }\n\n    /**\n     * Tests whether the character is ASCII printable.\n     *\n     * @param ch the character to test.\n     * @return true if the character is in the range 32 to 126 inclusive.\n     */\n    static boolean isAsciiPrintable(final char ch) {\n        return ch >= 32 && ch < 127;\n    }\n\n    /**\n     * Tests whether the character is a hexadecimal digit.\n     *\n     * @param ch the character to test.\n     * @return true if the character is in {@code 0-9}, {@code a-f}, or {@code A-F}.\n     */\n    static boolean isHex(final char ch) {\n        return isAsciiNumeric(ch) || ch >= 'a' && ch <= 'f' || ch >= 'A' && ch <= 'F';\n    }\n\n    /**\n     * Tests whether the 