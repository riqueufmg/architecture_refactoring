rs.\n     */\n    @Override\n    public void close() throws IOException {\n        super.close();\n        in.close();\n    }\n\n    /**\n     * {@inheritDoc}\n     */\n    @Override\n    public synchronized void mark(final int readLimit) {\n        throw UnsupportedOperationExceptions.mark();\n    }\n}\n","exit_code":0,"status":"completed"}}
