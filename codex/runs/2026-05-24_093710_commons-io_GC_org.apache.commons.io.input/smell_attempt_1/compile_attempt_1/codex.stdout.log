r to output to the stream.\n     */\n    private int handleEos() {\n        if (!lineFeedAtEos) {\n            return EOF;\n        }\n        if (!atSlashLf && !atSlashCr) {\n            atSlashCr = true;\n            return CR;\n        }\n        if (!atSlashLf) {\n            atSlashCr = false;\n            atSlashLf = true;\n            return LF;\n        }\n        return EOF;\n    }\n\n    /**\n     * {@inheritDoc}\n     */\n    @Override\n    public synchronized int read() throws IOException {\n        if (atEos) {\n            return handleEos();\n        }\n        if (injectSlashLf) {\n            injectSlashLf = false;\n            return LF;\n        }\n        final boolean prevWasSlashR = atSlashCr;\n        final int target = in.read();\n        atEos = target == EOF;\n        if (!atEos) {\n            atSlashCr = target == CR;\n            atSlashLf = target == LF;\n        }\n        if (atEos) {\n            return handleEos();\n        }\n        if (target == LF && !prevWasSlashR) {\n            injectSlashLf = true;\n            return CR;\n","exit_code":0,"status":"completed"}}
