{"type":"item.completed","item":{"id":"item_6","type":"command_execution","command":"/bin/bash -lc \"nl -ba src/main/java/org/jsoup/nodes/Element.java | sed -n '320,820p'\"","aggregated_output":"   320\t    /**\n   321\t     * Get this element's parent and ancestors, up to the document root.\n   322\t     * @return this element's stack of parents, starting with the closest first.\n   323\t     */\n   324\t    public Elements parents() {\n   325\t        Elements parents = new Elements();\n   326\t        Element parent = this.parent();\n   327\t        while (parent != null && !parent.nameIs(\"#root\")) {\n   328\t            parents.add(parent);\n   329\t            parent = parent.parent();\n   330\t        }\n   331\t        return parents;\n   332\t    }\n   333\t\n   334\t    /**\n   335\t     * Get a child element of this element, by its 0-based index number.\n   336\t     * <p>\n   337\t     * Note that an element can have both mixed Nodes and Elements as children. This method inspects\n   338\t     * a filtered list of children that are elements, and the index is based on that filtered list.\n   339\t     * </p>\n   340\t     *\n   341\t     * @param index the index number of the element to retrieve\n   342\t     * @return the child element, if it exists, otherwise throws an {@code IndexOutOfBoundsException}\n   343\t     * @see #childNode(int)\n   344\t     */\n   345\t    public Element child(int index) {\n   346\t        Validate.isTrue(index >= 0, \"Index must be >= 0\");\n   347\t        List<Element> cached = cachedChildren();\n   348\t        if (cached != null) return cached.get(index);\n   349\t        // otherwise, iter on elementChild; saves creating list\n   350\t        int size = childNodes.size();\n   351\t        for (int i = 0, e = 0; i < size; i++) { // direct iter is faster than chasing firstElSib, nextElSibd\n   352\t            Node node = childNodes.get(i);\n   353\t            if (node instanceof Element) {\n   354\t                if (e++ == index) return (Element) node;\n   355\t            }\n   356\t        }\n   357\t        throw new IndexOutOfBoundsException(\"No child at index: \" + index);\n   358\t    }\n   359\t\n   360\t    /**\n   361\t     * Get the number of child nodes of this element that are elements.\n   362\t     * <p>\n   363\t     * This method works on the same filtered list like {@link #child(int)}. Use {@link #childNodes()} and {@link\n   364\t     * #childNodeSize()} to get the unfiltered Nodes (e.g. includes TextNodes etc.)\n   365\t     * </p>\n   366\t     *\n   367\t     * @return the number of child nodes that are elements\n   368\t     * @see #children()\n   369\t     * @see #child(int)\n   370\t     */\n   371\t    public int childrenSize() {\n   372\t        if (childNodeSize() == 0) return 0;\n   373\t        return childElementsList().size(); // gets children into cache; faster subsequent child(i) if unmodified\n   374\t    }\n   375\t\n   376\t    /**\n   377\t     * Get this element's child elements.\n   378\t     * <p>\n   379\t     * This is effectively a filter on {@link #childNodes()} to get Element nodes.\n   380\t     * </p>\n   381\t     * @return child elements. If this element has no children, returns an empty list.\n   382\t     * @see #childNodes()\n   383\t     */\n   384\t    public Elements children() {\n   385\t        return new Elements(childElementsList());\n   386\t    }\n   387\t\n   388\t    /**\n   389\t     * Maintains a shadow copy of this element's child elements. If the nodelist is changed, this cache is invalidated.\n   390\t     * @return a list of child elements\n   391\t     */\n   392\t    List<Element> childElementsList() {\n   393\t        if (childNodeSize() == 0) return EmptyChildren; // short circuit creating empty\n   394\t        // set atomically, so works in multi-thread. Calling methods look like reads, so should be thread-safe\n   395\t        synchronized (childNodes) { // sync vs re-entrant lock, to save another field\n   396\t            List<Element> children = cachedChildren();\n   397\t            if (children == null) {\n   398\t                children = filterNodes(Element.class);\n   399\t                stashChildren(children);\n   400\t            }\n   401\t            return children;\n   402\t        }\n   403\t    }\n   404\t\n   405\t    private static final String childElsKey = \"jsoup.childEls\";\n   406\t    private static final String childElsMod = \"jsoup.childElsMod\";\n   407\t\n   408\t    /** returns the cached child els, if they exist, and the modcount of our childnodes matches the stashed modcount */\n   409\t    @SuppressWarnings(\"unchecked\")\n   410\t    @Nullable List<Element> cachedChildren() {\n   411\t        if (attributes == null || !attributes.hasUserData()) return null; // don't create empty userdata\n   412\t        Map<String, Object> userData = attributes.userData();\n   413\t        WeakReference<List<Element>> ref = (WeakReference<List<Element>>) userData.get(childElsKey);\n   414\t        if (ref != null) {\n   415\t            List<Element> els = ref.get();\n   416\t            if (els != null) {\n   417\t                Integer modCount = (Integer) userData.get(childElsMod);\n   418\t                if (modCount != null && modCount == childNodes.modCount())\n   419\t                    return els;\n   420\t            }\n   421\t        }\n   422\t        return null;\n   423\t    }\n   424\t\n   425\t    /** caches the child els into the Attribute user data. */\n   426\t    private void stashChildren(List<Element> els) {\n   427\t        Map<String, Object> userData = attributes().userData();\n   428\t        WeakReference<List<Element>> ref = new WeakReference<>(els);\n   429\t        userData.put(childElsKey, ref);\n   430\t        userData.put(childElsMod, childNodes.modCount());\n   431\t    }\n   432\t\n   433\t    /**\n   434\t     Returns a Stream of this Element and all of its descendant Elements. The stream has document order.\n   435\t     @return a stream of this element and its descendants.\n   436\t     @see #nodeStream()\n   437\t     @since 1.17.1\n   438\t     */\n   439\t    public Stream<Element> stream() {\n   440\t        return NodeUtils.stream(this, Element.class);\n   441\t    }\n   442\t\n   443\t    private <T> List<T> filterNodes(Class<T> clazz) {\n   444\t        return childNodes.stream()\n   445\t                .filter(clazz::isInstance)\n   446\t                .map(clazz::cast)\n   447\t                .collect(Collectors.collectingAndThen(Collectors.toList(), Collections::unmodifiableList));\n   448\t    }\n   449\t\n   450\t    /**\n   451\t     * Get this element's child text nodes. The list is unmodifiable but the text nodes may be manipulated.\n   452\t     * <p>\n   453\t     * This is effectively a filter on {@link #childNodes()} to get Text nodes.\n   454\t     * @return child text nodes. If this element has no text nodes, returns an\n   455\t     * empty list.\n   456\t     * </p>\n   457\t     * For example, with the input HTML: {@code <p>One <span>Two</span> Three <br> Four</p>} with the {@code p} element selected:\n   458\t     * <ul>\n   459\t     *     <li>{@code p.text()} = {@code \"One Two Three Four\"}</li>\n   460\t     *     <li>{@code p.ownText()} = {@code \"One Three Four\"}</li>\n   461\t     *     <li>{@code p.children()} = {@code Elements[<span>, <br>]}</li>\n   462\t     *     <li>{@code p.childNodes()} = {@code List<Node>[\"One \", <span>, \" Three \", <br>, \" Four\"]}</li>\n   463\t     *     <li>{@code p.textNodes()} = {@code List<TextNode>[\"One \", \" Three \", \" Four\"]}</li>\n   464\t     * </ul>\n   465\t     */\n   466\t    public List<TextNode> textNodes() {\n   467\t        return filterNodes(TextNode.class);\n   468\t    }\n   469\t\n   470\t    /**\n   471\t     * Get this element's child data nodes. The list is unmodifiable but the data nodes may be manipulated.\n   472\t     * <p>\n   473\t     * This is effectively a filter on {@link #childNodes()} to get Data nodes.\n   474\t     * </p>\n   475\t     * @return child data nodes. If this element has no data nodes, returns an\n   476\t     * empty list.\n   477\t     * @see #data()\n   478\t     */\n   479\t    public List<DataNode> dataNodes() {\n   480\t        return filterNodes(DataNode.class);\n   481\t    }\n   482\t\n   483\t    /**\n   484\t     * Find elements that match the {@link Selector} CSS query, with this element as the starting context. Matched elements\n   485\t     * may include this element, or any of its descendents.\n   486\t     * <p>If the query starts with a combinator (e.g. {@code *} or {@code >}), that will combine to this element.</p>\n   487\t     * <p>This method is generally more powerful to use than the DOM-type {@code getElementBy*} methods, because\n   488\t     * multiple filters can be combined, e.g.:</p>\n   489\t     * <ul>\n   490\t     * <li>{@code el.select(\"a[href]\")} - finds links ({@code a} tags with {@code href} attributes)</li>\n   491\t     * <li>{@code el.select(\"a[href*=example.com]\")} - finds links pointing to example.com (loosely)</li>\n   492\t     * <li>{@code el.select(\"* div\")} - finds all divs that descend from this element (and excludes this element)</li>\n   493\t     * <li>{@code el.select(\"> div\")} - finds all divs that are direct children of this element (and excludes this element)</li>\n   494\t     * </ul>\n   495\t     * <p>See the query syntax documentation in {@link org.jsoup.select.Selector}.</p>\n   496\t     * <p>Also known as {@code querySelectorAll()} in the Web DOM.</p>\n   497\t     *\n   498\t     * @param cssQuery a {@link Selector} CSS-like query\n   499\t     * @return an {@link Elements} list containing elements that match the query (empty if none match)\n   500\t     * @see Selector selector query syntax\n   501\t     * @see #select(Evaluator)\n   502\t     * @throws Selector.SelectorParseException (unchecked) on an invalid CSS query.\n   503\t     */\n   504\t    public Element appendChild(Node child) {\n   505\t        Validate.notNull(child);\n   506\t\n   507\t        // was - Node#addChildren(child). short-circuits an array create and a loop.\n   508\t        reparentChild(child);\n   509\t        ensureChildNodes();\n   510\t        childNodes.add(child);\n   511\t        child.setSiblingIndex(childNodes.size() - 1);\n   512\t        return this;\n   513\t    }\n   514\t\n   515\t    /**\n   516\t     Insert the given nodes to the end of this Element's children.\n   517\t\n   518\t     @param children nodes to add\n   519\t     @return this Element, for chaining\n   520\t     @see #insertChildren(int, Collection)\n   521\t     */\n   522\t    public Element appendChildren(Collection<? extends Node> children) {\n   523\t        insertChildren(-1, children);\n   524\t        return this;\n   525\t    }\n   526\t\n   527\t    /**\n   528\t     * Add this element to the supplied parent element, as its next child.\n   529\t     *\n   530\t     * @param parent element to which this element will be appended\n   531\t     * @return this element, so that you can continue modifying the element\n   532\t     */\n   533\t    public Element appendTo(Element parent) {\n   534\t        Validate.notNull(parent);\n   535\t        parent.appendChild(this);\n   536\t        return this;\n   537\t    }\n   538\t\n   539\t    /**\n   540\t     * Add a node to the start of this element's children.\n   541\t     *\n   542\t     * @param child node to add.\n   543\t     * @return this element, so that you can add more child nodes or elements.\n   544\t     */\n   545\t    public Element prependChild(Node child) {\n   546\t        Validate.notNull(child);\n   547\t\n   548\t        addChildren(0, child);\n   549\t        return this;\n   550\t    }\n   551\t\n   552\t    /**\n   553\t     Insert the given nodes to the start of this Element's children.\n   554\t\n   555\t     @param children nodes to add\n   556\t     @return this Element, for chaining\n   557\t     @see #insertChildren(int, Collection)\n   558\t     */\n   559\t    public Element prependChildren(Collection<? extends Node> children) {\n   560\t        insertChildren(0, children);\n   561\t        return this;\n   562\t    }\n   563\t\n   564\t\n   565\t    /**\n   566\t     * Inserts the given child nodes into this element at the specified index. Current nodes will be shifted to the\n   567\t     * right. The inserted nodes will be moved from their current parent. To prevent moving, copy the nodes first.\n   568\t     *\n   569\t     * @param index 0-based index to insert children at. Specify {@code 0} to insert at the start, {@code -1} at the\n   570\t     * end\n   571\t     * @param children child nodes to insert\n   572\t     * @return this element, for chaining.\n   573\t     */\n   574\t    public Element insertChildren(int index, Collection<? extends Node> children) {\n   575\t        Validate.notNull(children, \"Children collection to be inserted must not be null.\");\n   576\t        int currentSize = childNodeSize();\n   577\t        if (index < 0) index += currentSize +1; // roll around\n   578\t        Validate.isTrue(index >= 0 && index <= currentSize, \"Insert position out of bounds.\");\n   579\t        addChildren(index, children.toArray(new Node[0]));\n   580\t        return this;\n   581\t    }\n   582\t\n   583\t    /**\n   584\t     * Inserts the given child nodes into this element at the specified index. Current nodes will be shifted to the\n   585\t     * right. The inserted nodes will be moved from their current parent. To prevent moving, copy the nodes first.\n   586\t     *\n   587\t     * @param index 0-based index to insert children at. Specify {@code 0} to insert at the start, {@code -1} at the\n   588\t     * end\n   589\t     * @param children child nodes to insert\n   590\t     * @return this element, for chaining.\n   591\t     */\n   592\t    public Element insertChildren(int index, Node... children) {\n   593\t        Validate.notNull(children, \"Children collection to be inserted must not be null.\");\n   594\t        int currentSize = childNodeSize();\n   595\t        if (index < 0) index += currentSize +1; // roll around\n   596\t        Validate.isTrue(index >= 0 && index <= currentSize, \"Insert position out of bounds.\");\n   597\t\n   598\t        addChildren(index, children);\n   599\t        return this;\n   600\t    }\n   601\t\n   602\t    /**\n   603\t     * Create a new element by tag name, and add it as this Element's last child.\n   604\t     *\n   605\t     * @param tagName the name of the tag (e.g. {@code div}).\n   606\t     * @return the new element, to allow you to add content to it, e.g.:\n   607\t     *  {@code parent.appendElement(\"h1\").attr(\"id\", \"header\").text(\"Welcome\");}\n   608\t     */\n   609\t    public Element appendElement(String tagName) {\n   610\t        return appendElement(tagName, tag.namespace());\n   611\t    }\n   612\t\n   613\t    /**\n   614\t     * Create a new element by tag name and namespace, add it as this Element's last child.\n   615\t     *\n   616\t     * @param tagName the name of the tag (e.g. {@code div}).\n   617\t     * @param namespace the namespace of the tag (e.g. {@link Parser#NamespaceHtml})\n   618\t     * @return the new element, in the specified namespace\n   619\t     */\n   620\t    public Element appendElement(String tagName, String namespace) {\n   621\t        Parser parser = NodeUtils.parser(this);\n   622\t        Element child = new Element(parser.tagSet().valueOf(tagName, namespace, parser.settings()), baseUri());\n   623\t        appendChild(child);\n   624\t        return child;\n   625\t    }\n   626\t\n   627\t    /**\n   628\t     * Create a new element by tag name, and add it as this Element's first child.\n   629\t     *\n   630\t     * @param tagName the name of the tag (e.g. {@code div}).\n   631\t     * @return the new element, to allow you to add content to it, e.g.:\n   632\t     *  {@code parent.prependElement(\"h1\").attr(\"id\", \"header\").text(\"Welcome\");}\n   633\t     */\n   634\t    public Element prependElement(String tagName) {\n   635\t        return prependElement(tagName, tag.namespace());\n   636\t    }\n   637\t\n   638\t    /**\n   639\t     * Create a new element by tag name and namespace, and add it as this Element's first child.\n   640\t     *\n   641\t     * @param tagName the name of the tag (e.g. {@code div}).\n   642\t     * @param namespace the namespace of the tag (e.g. {@link Parser#NamespaceHtml})\n   643\t     * @return the new element, in the specified namespace\n   644\t     */\n   645\t    public Element prependElement(String tagName, String namespace) {\n   646\t        Parser parser = NodeUtils.parser(this);\n   647\t        Element child = new Element(parser.tagSet().valueOf(tagName, namespace, parser.settings()), baseUri());\n   648\t        prependChild(child);\n   649\t        return child;\n   650\t    }\n   651\t\n   652\t    /**\n   653\t     * Create and append a new TextNode to this element.\n   654\t     *\n   655\t     * @param text the (un-encoded) text to add\n   656\t     * @return this element\n   657\t     */\n   658\t    public Element appendText(String text) {\n   659\t        Validate.notNull(text);\n   660\t        TextNode node = new TextNode(text);\n   661\t        appendChild(node);\n   662\t        return this;\n   663\t    }\n   664\t\n   665\t    /**\n   666\t     * Create and prepend a new TextNode to this element.\n   667\t     *\n   668\t     * @param text the decoded text to add\n   669\t     * @return this element\n   670\t     */\n   671\t    public Element prependText(String text) {\n   672\t        Validate.notNull(text);\n   673\t        TextNode node = new TextNode(text);\n   674\t        prependChild(node);\n   675\t        return this;\n   676\t    }\n   677\t\n   678\t    /**\n   679\t     * Add inner HTML to this element. The supplied HTML will be parsed, and each node appended to the end of the children.\n   680\t     * @param html HTML to add inside this element, after the existing HTML\n   681\t     * @return this element\n   682\t     * @see #html(String)\n   683\t     */\n   684\t    public Element append(String html) {\n   685\t        Validate.notNull(html);\n   686\t        List<Node> nodes = NodeUtils.parser(this).parseFragmentInput(html, this, baseUri());\n   687\t        addChildren(nodes.toArray(new Node[0]));\n   688\t        return this;\n   689\t    }\n   690\t\n   691\t    /**\n   692\t     * Add inner HTML into this element. The supplied HTML will be parsed, and each node prepended to the start of the element's children.\n   693\t     * @param html HTML to add inside this element, before the existing HTML\n   694\t     * @return this element\n   695\t     * @see #html(String)\n   696\t     */\n   697\t    public Element prepend(String html) {\n   698\t        Validate.notNull(html);\n   699\t        List<Node> nodes = NodeUtils.parser(this).parseFragmentInput(html, this, baseUri());\n   700\t        addChildren(0, nodes.toArray(new Node[0]));\n   701\t        return this;\n   702\t    }\n   703\t\n   704\t    /**\n   705\t     * Insert the specified HTML into the DOM before this element (as a preceding sibling).\n   706\t     *\n   707\t     * @param html HTML to add before this element\n   708\t     * @return this element, for chaining\n   709\t     * @see #after(String)\n   710\t     */\n   711\t    @Override\n   712\t    public Element before(String html) {\n   713\t        return (Element) super.before(html);\n   714\t    }\n   715\t\n   716\t    /**\n   717\t     * Insert the specified node into the DOM before this node (as a preceding sibling).\n   718\t     * @param node to add before this element\n   719\t     * @return this Element, for chaining\n   720\t     * @see #after(Node)\n   721\t     */\n   722\t    @Override\n   723\t    public Element before(Node node) {\n   724\t        return (Element) super.before(node);\n   725\t    }\n   726\t\n   727\t    /**\n   728\t     * Insert the specified HTML into the DOM after this element (as a following sibling).\n   729\t     *\n   730\t     * @param html HTML to add after this element\n   731\t     * @return this element, for chaining\n   732\t     * @see #before(String)\n   733\t     */\n   734\t    @Override\n   735\t    public Element after(String html) {\n   736\t        return (Element) super.after(html);\n   737\t    }\n   738\t\n   739\t    /**\n   740\t     * Insert the specified node into the DOM after this node (as a following sibling).\n   741\t     * @param node to add after this element\n   742\t     * @return this element, for chaining\n   743\t     * @see #before(Node)\n   744\t     */\n   745\t    @Override\n   746\t    public Element after(Node node) {\n   747\t        return (Element) super.after(node);\n   748\t    }\n   749\t\n   750\t    /**\n   751\t     * Remove all the element's child nodes. Any attributes are left as-is. Each child node has its parent set to\n   752\t     * {@code null}.\n   753\t     * @return this element\n   754\t     */\n   755\t    @Override\n   756\t    public Element empty() {\n   757\t        // Detach each of the children -> parent links:\n   758\t        int size = childNodes.size();\n   759\t        for (int i = 0; i < size; i++)\n   760\t            childNodes.get(i).parentNode = null;\n   761\t        childNodes.clear();\n   762\t        return this;\n   763\t    }\n   764\t\n   765\t    /**\n   766\t     * Wrap the supplied HTML around this element.\n   767\t     *\n   768\t     * @param html HTML to wrap around this element, e.g. {@code <div class=\"head\"></div>}. Can be arbitrarily deep.\n   769\t     * @return this element, for chaining.\n   770\t     */\n   771\t    @Override\n   772\t    public Element wrap(String html) {\n   773\t        return (Element) super.wrap(html);\n   774\t    }\n   775\t\n   776\t    /**\n   777\t     Gets an #id selector for this element, if it has a unique ID. Otherwise, returns an empty string.\n   778\t\n   779\t     @param ownerDoc the document that owns this element, if there is one\n   780\t     */\n   781\t    private String uniqueIdSelector(@Nullable Document ownerDoc) {\n   782\t        String id = id();\n   783\t        if (!id.isEmpty()) { // check if the ID is unique and matches this\n   784\t            String idSel = \"#\" + escapeCssIdentifier(id);\n   785\t            if (ownerDoc != null) {\n   786\t                Elements els = ownerDoc.select(idSel);\n   787\t                if (els.size() == 1 && els.get(0) == this) return idSel;\n   788\t            } else {\n   789\t                return idSel;\n   790\t            }\n   791\t        }\n   792\t        return EmptyString;\n   793\t    }\n   794\t\n   795\t    /**\n   796\t     Get a CSS selector that will uniquely select this element.\n   797\t     <p>\n   798\t     If the element has an ID, returns #id; otherwise returns the parent (if any) CSS selector, followed by\n   799\t     {@literal '>'}, followed by a unique selector for the element (tag.class.class:nth-child(n)).\n   800\t     </p>\n   801\t\n   802\t     @return the CSS Path that can be used to retrieve the element in a selector.\n   803\t     */\n   804\t    public String cssSelector() {\n   805\t        Document ownerDoc = ownerDocument();\n   806\t        String idSel = uniqueIdSelector(ownerDoc);\n   807\t        if (!idSel.isEmpty()) return idSel;\n   808\t\n   809\t        // No unique ID, work up the parent stack and find either a unique ID to hang from, or just a GP > Parent > Child chain\n   810\t        StringBuilder selector = StringUtil.borrowBuilder();\n   811\t        Element el = this;\n   812\t        while (el != null && !(el instanceof Document)) {\n   813\t            idSel = el.uniqueIdSelector(ownerDoc);\n   814\t            if (!idSel.isEmpty()) {\n   815\t                selector.insert(0, idSel);\n   816\t                break; // found a unique ID to use as ancestor; stop\n   817\t            }\n   818\t            selector.insert(0, el.cssSelectorComponent());\n   819\t            el = el.parent();\n   820\t        }\n","exit_code":0,"status":"completed"}}
