   * @see String#replaceAll(String, String)\n   372\t     * @see Pattern#DOTALL\n   373\t     * @deprecated Use {@link #removePattern(CharSequence, String)}.\n   374\t     */\n   375\t    @Deprecated\n   376\t    public static String removePattern(final String text, final String regex) {\n   377\t        return replacePattern((CharSequence) text, regex, StringUtils.EMPTY);\n   378\t    }\n   379\t\n   380\t    /**\n   381\t     * Replaces each substring of the text String that matches the given regular expression pattern with the given replacement.\n   382\t     *\n   383\t     * This method is a {@code null} safe equivalent to:\n   384\t     * <ul>\n   385\t     *  <li>{@code pattern.matcher(text).replaceAll(replacement)}</li>\n   386\t     * </ul>\n   387\t     *\n   388\t     * <p>A {@code null} reference passed to this method is a no-op.</p>\n   389\t     *\n   390\t     * <pre>{@code\n   391\t     * RegExUtils.replaceAll(null, *, *)       = null\n   392\t     * RegExUtils.replaceAll(\"any\", (Pattern) null, *)   = \"any\"\n   393\t     * RegExUtils.replaceAll(\"any\", *, null)   = \"any\"\n   394\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\"\"), \"zzz\")    = \"zzz\"\n   395\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\".*\"), \"zzz\")  = \"zzz\"\n   396\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\".+\"), \"zzz\")  = \"\"\n   397\t     * RegExUtils.replaceAll(\"abc\", Pattern.compile(\"\"), \"ZZ\")  = \"ZZaZZbZZcZZ\"\n   398\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"<.*>\"), \"z\")                 = \"z\\nz\"\n   399\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"<.*>\", Pattern.DOTALL), \"z\") = \"z\"\n   400\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"(?s)<.*>\"), \"z\")             = \"z\"\n   401\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[a-z]\"), \"_\")       = \"ABC___123\"\n   402\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[^A-Z0-9]+\"), \"_\")  = \"ABC_123\"\n   403\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[^A-Z0-9]+\"), \"\")   = \"ABC123\"\n   404\t     * RegExUtils.replaceAll(\"Lorem ipsum  dolor   sit\", Pattern.compile(\"( +)([a-z]+)\"), \"_$2\")  = \"Lorem_ipsum_dolor_sit\"\n   405\t     * }</pre>\n   406\t     *\n   407\t     * @param text  text to search and replace in, may be null.\n   408\t     * @param regex  the regular expression pattern to which this string is to be matched.\n   409\t     * @param replacement  the string to be substituted for each match.\n   410\t     * @return  the text with any replacements processed,\n   411\t     *              {@code null} if null String input.\n   412\t     * @see java.util.regex.Matcher#replaceAll(String)\n   413\t     * @see java.util.regex.Pattern\n   414\t     */\n   415\t    public static String replaceAll(final CharSequence text, final Pattern regex, final String replacement) {\n   416\t        return RegExReplacementUtils.replaceAll(text, regex, replacement);\n   417\t    }\n   418\t\n   419\t    /**\n   420\t     * Replaces each substring of the text String that matches the given regular expression pattern with the given replacement.\n   421\t     *\n   422\t     * This method is a {@code null} safe equivalent to:\n   423\t     * <ul>\n   424\t     *  <li>{@code pattern.matcher(text).replaceAll(replacement)}</li>\n   425\t     * </ul>\n   426\t     *\n   427\t     * <p>A {@code null} reference passed to this method is a no-op.</p>\n   428\t     *\n   429\t     * <pre>{@code\n   430\t     * RegExUtils.replaceAll(null, *, *)       = null\n   431\t     * RegExUtils.replaceAll(\"any\", (Pattern) null, *)   = \"any\"\n   432\t     * RegExUtils.replaceAll(\"any\", *, null)   = \"any\"\n   433\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\"\"), \"zzz\")    = \"zzz\"\n   434\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\".*\"), \"zzz\")  = \"zzz\"\n   435\t     * RegExUtils.replaceAll(\"\", Pattern.compile(\".+\"), \"zzz\")  = \"\"\n   436\t     * RegExUtils.replaceAll(\"abc\", Pattern.compile(\"\"), \"ZZ\")  = \"ZZaZZbZZcZZ\"\n   437\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"<.*>\"), \"z\")                 = \"z\\nz\"\n   438\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"<.*>\", Pattern.DOTALL), \"z\") = \"z\"\n   439\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", Pattern.compile(\"(?s)<.*>\"), \"z\")             = \"z\"\n   440\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[a-z]\"), \"_\")       = \"ABC___123\"\n   441\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[^A-Z0-9]+\"), \"_\")  = \"ABC_123\"\n   442\t     * RegExUtils.replaceAll(\"ABCabc123\", Pattern.compile(\"[^A-Z0-9]+\"), \"\")   = \"ABC123\"\n   443\t     * RegExUtils.replaceAll(\"Lorem ipsum  dolor   sit\", Pattern.compile(\"( +)([a-z]+)\"), \"_$2\")  = \"Lorem_ipsum_dolor_sit\"\n   444\t     * }</pre>\n   445\t     *\n   446\t     * @param text  text to search and replace in, may be null.\n   447\t     * @param regex  the regular expression pattern to which this string is to be matched.\n   448\t     * @param replacement  the string to be substituted for each match.\n   449\t     * @return  the text with any replacements processed,\n   450\t     *              {@code null} if null String input.\n   451\t     * @see java.util.regex.Matcher#replaceAll(String)\n   452\t     * @see java.util.regex.Pattern\n   453\t     * @deprecated Use {@link #replaceAll(CharSequence, Pattern, String)}.\n   454\t     */\n   455\t    @Deprecated\n   456\t    public static String replaceAll(final String text, final Pattern regex, final String replacement) {\n   457\t        return replaceAll((CharSequence) text, regex, replacement);\n   458\t    }\n   459\t\n   460\t    /**\n   461\t     * Replaces each substring of the text String that matches the given regular expression\n   462\t     * with the given replacement.\n   463\t     *\n   464\t     * This method is a {@code null} safe equivalent to:\n   465\t     * <ul>\n   466\t     *  <li>{@code text.replaceAll(regex, replacement)}</li>\n   467\t     *  <li>{@code Pattern.compile(regex).matcher(text).replaceAll(replacement)}</li>\n   468\t     * </ul>\n   469\t     *\n   470\t     * <p>A {@code null} reference passed to this method is a no-op.</p>\n   471\t     *\n   472\t     * <p>Unlike in the {@link #replacePattern(CharSequence, String, String)} method, the {@link Pattern#DOTALL} option\n   473\t     * is NOT automatically added.\n   474\t     * To use the DOTALL option prepend {@code \"(?s)\"} to the regex.\n   475\t     * DOTALL is also known as single-line mode in Perl.</p>\n   476\t     *\n   477\t     * <pre>{@code\n   478\t     * RegExUtils.replaceAll(null, *, *)       = null\n   479\t     * RegExUtils.replaceAll(\"any\", (String) null, *)   = \"any\"\n   480\t     * RegExUtils.replaceAll(\"any\", *, null)   = \"any\"\n   481\t     * RegExUtils.replaceAll(\"\", \"\", \"zzz\")    = \"zzz\"\n   482\t     * RegExUtils.replaceAll(\"\", \".*\", \"zzz\")  = \"zzz\"\n   483\t     * RegExUtils.replaceAll(\"\", \".+\", \"zzz\")  = \"\"\n   484\t     * RegExUtils.replaceAll(\"abc\", \"\", \"ZZ\")  = \"ZZaZZbZZcZZ\"\n   485\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", \"<.*>\", \"z\")      = \"z\\nz\"\n   486\t     * RegExUtils.replaceAll(\"<__>\\n<__>\", \"(?s)<.*>\", \"z\")  = \"z\"\n   487\t     * RegExUtils.replaceAll(\"ABCabc123\", \"[a-z]\", \"_\")       = \"ABC___123\"\n   488\t     * RegExUtils.replaceAll(\"ABCabc123\", \"[^A-Z0-9]+\", \"_\")  = \"ABC_123\"\n   489\t     * RegExUtils.replaceAll(\"ABCabc123\", \"[^A-Z0-9]+\", \"\")   = \"ABC123\"\n   490\t     * RegExUtils.replaceAll(\"Lorem ipsum  dolor   sit\", \"( +)([a-z]+)\", \"_$2\")  = \"Lorem_ipsum_dolor_sit\"\n   491\t     * }</pre>\n   492\t     *\n   493\t     * @param text  text to search and replace in, may be null.\n   494\t     * @param regex  the regular expression to which this string is to be matched.\n   495\t     * @param replacement  the string to be substituted for each match.\n   496\t     * @return  the text with any replacements processed,\n   497\t     *              {@code null} if null String input.\n   498\t     * @throws  java.util.regex.PatternSyntaxException\n   499\t     *              if the regular expression's syntax is invalid.\n   500\t     * @see #replacePattern(String, String, String)\n   501\t     * @see String#replaceAll(String, String)\n   502\t     * @see java.util.regex.Pattern\n   503\t     * @see java.util.regex.Pattern#DOTALL\n   504\t     */\n   505\t    public static String replaceAll(final String text, final String regex, final String replacement) {\n   506\t        return RegExReplacementUtils.replaceAll(text, regex, replacement);\n   507\t    }\n   508\t\n   509\t    /**\n   510\t     * Replaces the first substring of the text string that matches the given regular expression pattern\n   511\t     * with the given replacement.\n   512\t     *\n   513\t     * This method is a {@code null} safe equivalent to:\n   514\t     * <ul>\n   515\t     *  <li>{@code pattern.matcher(text).replaceFirst(replacement)}</li>\n   516\t     * </ul>\n   517\t     *\n   518\t     * <p>A {@code null} reference passed to this method is a no-op.</p>\n   519\t     *\n   520\t     * <pre>{@code\n   521\t     * RegExUtils.replaceFirst(null, *, *)       = null\n   522\t     * RegExUtils.replaceFirst(\"any\", (Pattern) null, *)   = \"any\"\n   523\t     * RegExUtils.replaceFirst(\"any\", *, null)   = \"any\"\n   524\t     * RegExUtils.replaceFirst(\"\", Pattern.compile(\"\"), \"zzz\")    = \"zzz\"\n   525\t     * RegExUtils.replaceFirst(\"\", Pattern.compile(\".*\"), \"zzz\")  = \"zzz\"\n   526\t     * RegExUtils.replaceFirst(\"\", Pattern.compile(\".+\"), \"zzz\")  = \"\"\n   527\t     * RegExUtils.replaceFirst(\"abc\", Pattern.compile(\"\"), \"ZZ\")  = \"ZZabc\"\n   528\t     * RegExUtils.replaceFirst(\"<__>\\n<__>\", Pattern.compile(\"<.*>\"), \"z\")      = \"z\\n<__>\"\n   529\t     * RegExUtils.replaceFirst(\"<__>\\n<__>\", Pattern.compile(\"(?s)<.*>\"), \"z\")  = \"z\"\n   530\t     * RegExUtils.replaceFirst(\"ABCabc123\", Pattern.compile(\"[a-z]\"), \"_\")          = \"ABC_bc123\"\n   531\t     * RegExUtils.replaceFirst(\"ABCabc123abc\", Pattern.compile(\"[^A-Z0-9]+\"), \"_\")  = \"ABC_123abc\"\n   532\t     * RegExUtils.replaceFirst(\"ABCabc123abc\", Pattern.compile(\"[^A-Z0-9]+\"), \"\")   = \"ABC123abc\"\n   533\t     * RegExUtils.replaceFirst(\"Lorem ipsum  dolor   sit\", Pattern.compile(\"( +)([a-z]+)\"), \"_$2\")  = \"Lorem_ipsum  dolor   sit\"\n   534\t     * }</pre>\n   535\t     *\n   536\t     * @param text  text to search and replace in, may be null.\n   537\t     * @param regex  the regular expression pattern to which this string is to be matched.\n   538\t     * @param replacement  the string to be substituted for the first match\n   539\t     * @return  the text with the first replacement processed,\n   540\t     *              {@code null} if null String input.\n   541\t     * @see java.util.regex.Matcher#replaceFirst(String)\n   542\t     * @see java.util.regex.Pattern\n   543\t     * @since 3.18.0\n   544\t     */\n   545\t    public static String replaceFirst(final CharSequence text, final Pattern regex, final String replacement) {\n   546\t        return RegExReplacementUtils.replaceFirst(text, regex, replacement);\n   547\t    }\n   548\t\n   549\t    /**\n   550\t     * Replaces the first substring of the text string that matches the given regular expression pattern\n   551\t     * with the given replacement.\n   552\t     *\n   553\t     * This method is a {@code null} safe equivalent to:\n   554\t     * <ul>\n   555\t     *  <li>{@code pattern.matcher(text).replaceFirst(replacement)}</li>\n   556\t     * </ul>\n   557\t     *\n   558\t     * <p>A {@code null} reference passed to this method is a no-op.</p>\n   559\t     *\n   560\t     * <pre>{@code\n   561\t     