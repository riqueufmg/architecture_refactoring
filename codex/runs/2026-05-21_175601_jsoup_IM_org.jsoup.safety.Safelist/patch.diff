-    private String getProtocolValue(Element el, Attribute attr) {
-        String value = el.absUrl(attr.getKey());
-        if (value.isEmpty())
-            value = attr.getValue(); // if it could not be made abs, run as-is to allow custom unknown protocols
-        return value;
-    }
