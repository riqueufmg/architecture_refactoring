{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' src/main/java/org/jsoup/safety/SafelistProtocols.java\"","aggregated_output":"package org.jsoup.safety;\n\nimport org.jsoup.helper.Validate;\nimport org.jsoup.nodes.Attribute;\nimport org.jsoup.nodes.Element;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Map;\nimport java.util.Set;\n\nimport static org.jsoup.internal.Normalizer.lowerCase;\n\nfinal class SafelistProtocols {\n    private final Map<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>>> protocols;\n\n    SafelistProtocols(Map<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>>> protocols) {\n        this.protocols = protocols;\n    }\n\n    void addProtocols(String tag, String attribute, String... addProtocols) {\n        Validate.notEmpty(tag);\n        Validate.notEmpty(attribute);\n        Validate.notNull(addProtocols);\n\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        SafelistValueTypes.AttributeKey attrKey = SafelistValueTypes.AttributeKey.valueOf(attribute);\n        Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> attrMap = protocols.computeIfAbsent(tagName, k -> new HashMap<>());\n        Set<SafelistValueTypes.Protocol> protSet = attrMap.computeIfAbsent(attrKey, k -> new HashSet<>());\n\n        for (String protocol : addProtocols) {\n            Validate.notEmpty(protocol);\n            protSet.add(SafelistValueTypes.Protocol.valueOf(protocol));\n        }\n    }\n\n    void removeProtocols(String tag, String attribute, String... removeProtocols) {\n        Validate.notEmpty(tag);\n        Validate.notEmpty(attribute);\n        Validate.notNull(removeProtocols);\n\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        SafelistValueTypes.AttributeKey attr = SafelistValueTypes.AttributeKey.valueOf(attribute);\n\n        Validate.isTrue(protocols.containsKey(tagName), \"Cannot remove a protocol that is not set.\");\n        Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> tagProtocols = protocols.get(tagName);\n        Validate.isTrue(tagProtocols.containsKey(attr), \"Cannot remove a protocol that is not set.\");\n\n        Set<SafelistValueTypes.Protocol> attrProtocols = tagProtocols.get(attr);\n        for (String protocol : removeProtocols) {\n            Validate.notEmpty(protocol);\n            attrProtocols.remove(SafelistValueTypes.Protocol.valueOf(protocol));\n        }\n\n        if (attrProtocols.isEmpty()) {\n            tagProtocols.remove(attr);\n            if (tagProtocols.isEmpty()) {\n                protocols.remove(tagName);\n            }\n        }\n    }\n\n    boolean isSafeAttributeProtocol(SafelistValueTypes.TagName tag, SafelistValueTypes.AttributeKey key, Element el, Attribute attr) {\n        if (!protocols.containsKey(tag)) {\n            return true;\n        }\n        Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> attrProts = protocols.get(tag);\n        return !attrProts.containsKey(key) || isSafeProtocol(getProtocolValue(el, attr), attrProts.get(key));\n    }\n\n    boolean shouldAbsUrl(SafelistValueTypes.TagName tag, SafelistValueTypes.AttributeKey key,\n                         Map<SafelistValueTypes.TagName, Set<SafelistValueTypes.AttributeKey>> attributes,\n                         Map<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue>> enforcedAttributes,\n                         SafelistValueTypes.TagName allTag,\n                         boolean preserveRelativeLinks) {\n        if (preserveRelativeLinks) return false;\n\n        Set<SafelistValueTypes.AttributeKey> allowedAttrs = attributes.get(tag);\n        if (allowedAttrs != null && allowedAttrs.contains(key)) {\n            Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> protocolsByAttr = protocols.get(tag);\n            return protocolsByAttr != null && protocolsByAttr.containsKey(key);\n        }\n\n        Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> enforcedAttrs = enforcedAttributes.get(tag);\n        if (enforcedAttrs != null && enforcedAttrs.containsKey(key)) return false;\n\n        return !tag.equals(allTag) && shouldAbsUrl(allTag, key, attributes, enforcedAttributes, allTag, false);\n    }\n\n    private static String getProtocolValue(Element el, Attribute attr) {\n        String value = el.absUrl(attr.getKey());\n        if (value.isEmpty()) value = attr.getValue();\n        return value;\n    }\n\n    private static boolean isSafeProtocol(String value, Set<SafelistValueTypes.Protocol> protocols) {\n        for (SafelistValueTypes.Protocol protocol : protocols) {\n            String prot = protocol.toString();\n            if (prot.equals(\"#\")) {\n                if (isValidAnchor(value)) return true;\n                continue;\n            }\n\n            prot += \":\";\n            if (lowerCase(value).startsWith(prot)) return true;\n        }\n        return false;\n    }\n\n    private static boolean isValidAnchor(String value) {\n        return value.startsWith(\"#\") && !value.matches(\".*\\\\s.*\");\n    }\n}\n","exit_code":0,"status":"completed"}}
