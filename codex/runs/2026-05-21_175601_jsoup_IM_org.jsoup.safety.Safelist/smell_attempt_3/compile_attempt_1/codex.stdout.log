{"type":"item.completed","item":{"id":"item_17","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' src/main/java/org/jsoup/safety/SafelistConfiguration.java\"","aggregated_output":"package org.jsoup.safety;\n\nimport org.jsoup.helper.Validate;\nimport org.jsoup.nodes.Attribute;\nimport org.jsoup.nodes.Attributes;\nimport org.jsoup.nodes.Element;\n\nimport java.util.HashMap;\nimport java.util.HashSet;\nimport java.util.Iterator;\nimport java.util.Map;\nimport java.util.Set;\n\nclass SafelistConfiguration {\n    static final String All = \":all\";\n    private static final SafelistValueTypes.TagName AllTag = SafelistValueTypes.TagName.valueOf(All);\n\n    final Set<SafelistValueTypes.TagName> tagNames;\n    final Map<SafelistValueTypes.TagName, Set<SafelistValueTypes.AttributeKey>> attributes;\n    final Map<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue>> enforcedAttributes;\n    final Map<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>>> protocols;\n    final SafelistProtocols safelistProtocols;\n    boolean preserveRelativeLinks;\n\n    SafelistConfiguration() {\n        tagNames = new HashSet<>();\n        attributes = new HashMap<>();\n        enforcedAttributes = new HashMap<>();\n        protocols = new HashMap<>();\n        safelistProtocols = new SafelistProtocols(protocols);\n        preserveRelativeLinks = false;\n    }\n\n    SafelistConfiguration(SafelistConfiguration copy) {\n        this();\n        tagNames.addAll(copy.tagNames);\n        for (Map.Entry<SafelistValueTypes.TagName, Set<SafelistValueTypes.AttributeKey>> copyTagAttributes : copy.attributes.entrySet()) {\n            attributes.put(copyTagAttributes.getKey(), new HashSet<>(copyTagAttributes.getValue()));\n        }\n        for (Map.Entry<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue>> enforcedEntry : copy.enforcedAttributes.entrySet()) {\n            enforcedAttributes.put(enforcedEntry.getKey(), new HashMap<>(enforcedEntry.getValue()));\n        }\n        for (Map.Entry<SafelistValueTypes.TagName, Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>>> protocolsEntry : copy.protocols.entrySet()) {\n            Map<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> attributeProtocolsCopy = new HashMap<>();\n            for (Map.Entry<SafelistValueTypes.AttributeKey, Set<SafelistValueTypes.Protocol>> attributeProtocols : protocolsEntry.getValue().entrySet()) {\n                attributeProtocolsCopy.put(attributeProtocols.getKey(), new HashSet<>(attributeProtocols.getValue()));\n            }\n            protocols.put(protocolsEntry.getKey(), attributeProtocolsCopy);\n        }\n        preserveRelativeLinks = copy.preserveRelativeLinks;\n    }\n\n    public Safelist addTags(String... tags) {\n        Validate.notNull(tags);\n\n        for (String tagName : tags) {\n            Validate.notEmpty(tagName);\n            Validate.isFalse(tagName.equalsIgnoreCase(\"noscript\"),\n                \"noscript is unsupported in Safelists, due to incompatibilities between parsers with and without script-mode enabled\");\n            tagNames.add(SafelistValueTypes.TagName.valueOf(tagName));\n        }\n        return (Safelist) this;\n    }\n\n    public Safelist removeTags(String... tags) {\n        Validate.notNull(tags);\n\n        for (String tag: tags) {\n            Validate.notEmpty(tag);\n            SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n\n            if (tagNames.remove(tagName)) {\n                attributes.remove(tagName);\n                enforcedAttributes.remove(tagName);\n                protocols.remove(tagName);\n            }\n        }\n        return (Safelist) this;\n    }\n\n    public Safelist addAttributes(String tag, String... attributes) {\n        Validate.notEmpty(tag);\n        Validate.notNull(attributes);\n        Validate.isTrue(attributes.length > 0, \"No attribute names supplied.\");\n\n        addTags(tag);\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        Set<SafelistValueTypes.AttributeKey> attributeSet = new HashSet<>();\n        for (String key : attributes) {\n            Validate.notEmpty(key);\n            attributeSet.add(SafelistValueTypes.AttributeKey.valueOf(key));\n        }\n        Set<SafelistValueTypes.AttributeKey> currentSet = this.attributes.computeIfAbsent(tagName, k -> new HashSet<>());\n        currentSet.addAll(attributeSet);\n        return (Safelist) this;\n    }\n\n    public Safelist removeAttributes(String tag, String... attributes) {\n        Validate.notEmpty(tag);\n        Validate.notNull(attributes);\n        Validate.isTrue(attributes.length > 0, \"No attribute names supplied.\");\n\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        Set<SafelistValueTypes.AttributeKey> attributeSet = new HashSet<>();\n        for (String key : attributes) {\n            Validate.notEmpty(key);\n            attributeSet.add(SafelistValueTypes.AttributeKey.valueOf(key));\n        }\n        if (tagNames.contains(tagName) && this.attributes.containsKey(tagName)) {\n            Set<SafelistValueTypes.AttributeKey> currentSet = this.attributes.get(tagName);\n            currentSet.removeAll(attributeSet);\n\n            if (currentSet.isEmpty())\n                this.attributes.remove(tagName);\n        }\n        if (tag.equals(All)) {\n            Iterator<Map.Entry<SafelistValueTypes.TagName, Set<SafelistValueTypes.AttributeKey>>> it = this.attributes.entrySet().iterator();\n            while (it.hasNext()) {\n                Map.Entry<SafelistValueTypes.TagName, Set<SafelistValueTypes.AttributeKey>> entry = it.next();\n                Set<SafelistValueTypes.AttributeKey> currentSet = entry.getValue();\n                currentSet.removeAll(attributeSet);\n                if (currentSet.isEmpty())\n                    it.remove();\n            }\n        }\n        return (Safelist) this;\n    }\n\n    public Safelist addEnforcedAttribute(String tag, String attribute, String value) {\n        Validate.notEmpty(tag);\n        Validate.notEmpty(attribute);\n        Validate.notEmpty(value);\n\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        tagNames.add(tagName);\n        SafelistValueTypes.AttributeKey attrKey = SafelistValueTypes.AttributeKey.valueOf(attribute);\n        SafelistValueTypes.AttributeValue attrVal = SafelistValueTypes.AttributeValue.valueOf(value);\n\n        Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> attrMap = enforcedAttributes.computeIfAbsent(tagName, k -> new HashMap<>());\n        attrMap.put(attrKey, attrVal);\n        return (Safelist) this;\n    }\n\n    public Safelist removeEnforcedAttribute(String tag, String attribute) {\n        Validate.notEmpty(tag);\n        Validate.notEmpty(attribute);\n\n        SafelistValueTypes.TagName tagName = SafelistValueTypes.TagName.valueOf(tag);\n        if (tagNames.contains(tagName) && enforcedAttributes.containsKey(tagName)) {\n            SafelistValueTypes.AttributeKey attrKey = SafelistValueTypes.AttributeKey.valueOf(attribute);\n            Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> attrMap = enforcedAttributes.get(tagName);\n            attrMap.remove(attrKey);\n\n            if (attrMap.isEmpty())\n                enforcedAttributes.remove(tagName);\n        }\n        return (Safelist) this;\n    }\n\n    public Safelist preserveRelativeLinks(boolean preserve) {\n        preserveRelativeLinks = preserve;\n        return (Safelist) this;\n    }\n\n    public boolean preserveRelativeLinks() {\n        return preserveRelativeLinks;\n    }\n\n    public Safelist addProtocols(String tag, String attribute, String... protocols) {\n        safelistProtocols.addProtocols(tag, attribute, protocols);\n        return (Safelist) this;\n    }\n\n    public Safelist removeProtocols(String tag, String attribute, String... removeProtocols) {\n        safelistProtocols.removeProtocols(tag, attribute, removeProtocols);\n        return (Safelist) this;\n    }\n\n    public boolean isSafeTag(String tag) {\n        return tagNames.contains(SafelistValueTypes.TagName.valueOf(tag));\n    }\n\n    public boolean isSafeAttribute(String tagName, Element el, Attribute attr) {\n        SafelistValueTypes.TagName tag = SafelistValueTypes.TagName.valueOf(tagName);\n        SafelistValueTypes.AttributeKey key = SafelistValueTypes.AttributeKey.valueOf(attr.getKey());\n\n        Set<SafelistValueTypes.AttributeKey> okSet = attributes.get(tag);\n        if (okSet != null && okSet.contains(key)) {\n            return safelistProtocols.isSafeAttributeProtocol(tag, key, el, attr);\n        }\n        Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> enforcedSet = enforcedAttributes.get(tag);\n        if (enforcedSet != null && enforcedSet.containsKey(key)) {\n            return enforcedSet.get(key).equals(SafelistValueTypes.AttributeValue.valueOf(attr.getValue()));\n        }\n        return !tagName.equals(All) && isSafeAttribute(All, el, attr);\n    }\n\n    boolean shouldAbsUrl(String tagName, String attrKey) {\n        return safelistProtocols.shouldAbsUrl(\n            SafelistValueTypes.TagName.valueOf(tagName),\n            SafelistValueTypes.AttributeKey.valueOf(attrKey),\n            attributes,\n            enforcedAttributes,\n            AllTag,\n            preserveRelativeLinks);\n    }\n\n    public Attributes getEnforcedAttributes(String tagName) {\n        Attributes attrs = new Attributes();\n        SafelistValueTypes.TagName tag = SafelistValueTypes.TagName.valueOf(tagName);\n        if (enforcedAttributes.containsKey(tag)) {\n            Map<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> keyVals = enforcedAttributes.get(tag);\n            for (Map.Entry<SafelistValueTypes.AttributeKey, SafelistValueTypes.AttributeValue> entry : keyVals.entrySet()) {\n                attrs.put(entry.getKey().toString(), entry.getValue().toString());\n            }\n        }\n        return attrs;\n    }\n}\n","exit_code":0,"status":"completed"}}
