= customizers;\n    42\t    }\n    43\t\n    44\t    public TagSet() {\n    45\t        this(null, null);\n    46\t    }\n    47\t\n    48\t    /**\n    49\t     Creates a new TagSet by copying the current tags and customizers from the provided source TagSet. Changes made to\n    50\t     one TagSet will not affect the other.\n    51\t     @param template the TagSet to copy\n    52\t     */\n    53\t    public TagSet(TagSet template) {\n    54\t        this(template.source, copyCustomizers(template));\n    55\t        // copy tags eagerly; any lazy pull-through should come only from the root source (which would be the HTML defaults), not the template itself.\n    56\t        // that way the template tagset is not mutated when we do read through\n    57\t        if (template.tags.isEmpty()) return;\n    58\t\n    59\t        for (Map.Entry<String, Map<String, Tag>> namespaceEntry : template.tags.entrySet()) {\n    60\t            Map<String, Tag> nsTags = new HashMap<>(namespaceEntry.getValue().size());\n    61\t            for (Map.Entry<String, Tag> tagEntry : namespaceEntry.getValue().entrySet()) {\n    62\t                nsTags.put(tagEntry.getKey(), tagEntry.getValue().clone());\n    63\t            }\n    64\t            tags.put(namespaceEntry.getKey(), nsTags);\n    65\t        }\n    66\t    }\n    67\t\n    68\t    private static @Nullable ArrayList<Consumer<Tag>> copyCustomizers(TagSet base) {\n    69\t        if (base.customizers == null) return null;\n    70\t        return new ArrayList<>(base.customizers);\n    71\t    }\n    72\t\n    73\t    /**\n    74\t     Insert a tag into this TagSet. If the tag already exists, it is replaced.\n    75\t     <p>Tags explicitly added like this are considered to be known tags (vs those that are dynamically created via\n    76\t     .valueOf() if not already in the set.</p>\n    77\t\n    78\t     @param tag the tag to add\n    79\t     @return this TagSet\n    80\t     */\n    81\t    public TagSet add(Tag tag) {\