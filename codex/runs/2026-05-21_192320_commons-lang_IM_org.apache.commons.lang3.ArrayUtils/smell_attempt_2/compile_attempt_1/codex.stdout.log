t     */\n  2633\t    public static BitSet indexesOf(final short[] array, final short valueToFind) {\n  2634\t        return indexesOf(array, valueToFind, 0);\n  2635\t    }\n  2636\t\n  2637\t    /**\n  2638\t     * Finds the indices of the given value in the array starting at the given index.\n  2639\t     *\n  2640\t     * <p>This method returns an empty BitSet for a {@code null} input array.</p>\n  2641\t     *\n  2642\t     * <p>A negative startIndex is treated as zero. A startIndex larger than the array\n  2643\t     * length will return an empty BitSet.</p>\n  2644\t     *\n  2645\t     * @param array  the array to search for the object, may be {@code null}.\n  2646\t     * @param valueToFind  the value to find.\n  2647\t     * @param startIndex  the index to start searching.\n  2648\t     * @return a BitSet of all the indices of the value within the array,\n  2649\t     *  an empty BitSet if not found or {@code null} array input.\n  2650\t     * @since 3.10\n  2651\t     */\n  2652\t    public static BitSet indexesOf(final short[] array, final short valueToFind, int startIndex) {\n  2653\t        final BitSet bitSet = new BitSet();\n  2654\t        if (array != null) {\n  2655\t            while (startIndex < array.length) {\n  2656\t                startIndex = indexOf(array, valueToFind, startIndex);\n  2657\t                if (startIndex == INDEX_NOT_FOUND) {\n  2658\t                    break;\n  2659\t                }\n  2660\t                bitSet.set(startIndex);\n  2661\t                ++startIndex;\n  2662\t            }\n  2663\t        }\n  2664\t        return bitSet;\n  2665\t    }\n  2666\t\n  2667\t    /**\n  2668\t     * Finds the index of the given value in the array.\n  2669\t     * <p>\n  2670\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2671\t     * </p>\n  2672\t     *\n  2673\t     * @param array       the array to search for the object, may be {@code null}.\n  2674\t     * @param valueToFind the value to find.\n  2675\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2676\t     */\n  2677\t    public static int indexOf(final boolean[] array, final boolean valueToFind) {\n  2678\t        return indexOf(array, valueToFind, 0);\n  2679\t    }\n  2680\t\n  2681\t    /**\n  2682\t     * Finds the index of the given value in the array starting at the given index.\n  2683\t     * <p>\n  2684\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2685\t     * </p>\n  2686\t     * <p>\n  2687\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2688\t     * </p>\n  2689\t     *\n  2690\t     * @param array       the array to search for the object, may be {@code null}.\n  2691\t     * @param valueToFind the value to find.\n  2692\t     * @param startIndex  the index to start searching.\n  2693\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2694\t     */\n  2695\t    public static int indexOf(final boolean[] array, final boolean valueToFind, final int startIndex) {\n  2696\t        if (isEmpty(array)) {\n  2697\t            return INDEX_NOT_FOUND;\n  2698\t        }\n  2699\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2700\t            if (valueToFind == array[i]) {\n  2701\t                return i;\n  2702\t            }\n  2703\t        }\n  2704\t        return INDEX_NOT_FOUND;\n  2705\t    }\n  2706\t\n  2707\t    /**\n  2708\t     * Finds the index of the given value in the array.\n  2709\t     * <p>\n  2710\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2711\t     * </p>\n  2712\t     *\n  2713\t     * @param array       the array to search for the object, may be {@code null}.\n  2714\t     * @param valueToFind the value to find.\n  2715\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2716\t     */\n  2717\t    public static int indexOf(final byte[] array, final byte valueToFind) {\n  2718\t        return indexOf(array, valueToFind, 0);\n  2719\t    }\n  2720\t\n  2721\t    /**\n  2722\t     * Finds the index of the given value in the array starting at the given index.\n  2723\t     * <p>\n  2724\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2725\t     * </p>\n  2726\t     * <p>\n  2727\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2728\t     * </p>\n  2729\t     *\n  2730\t     * @param array       the array to search for the object, may be {@code null}.\n  2731\t     * @param valueToFind the value to find.\n  2732\t     * @param startIndex  the index to start searching.\n  2733\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2734\t     */\n  2735\t    public static int indexOf(final byte[] array, final byte valueToFind, final int startIndex) {\n  2736\t        if (isEmpty(array)) {\n  2737\t            return INDEX_NOT_FOUND;\n  2738\t        }\n  2739\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2740\t            if (valueToFind == array[i]) {\n  2741\t                return i;\n  2742\t            }\n  2743\t        }\n  2744\t        return INDEX_NOT_FOUND;\n  2745\t    }\n  2746\t\n  2747\t    /**\n  2748\t     * Finds the index of the given value in the array.\n  2749\t     * <p>\n  2750\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2751\t     * </p>\n  2752\t     *\n  2753\t     * @param array       the array to search for the object, may be {@code null}.\n  2754\t     * @param valueToFind the value to find.\n  2755\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2756\t     * @since 2.1\n  2757\t     */\n  2758\t    public static int indexOf(final char[] array, final char valueToFind) {\n  2759\t        return indexOf(array, valueToFind, 0);\n  2760\t    }\n  2761\t\n  2762\t    /**\n  2763\t     * Finds the index of the given value in the array starting at the given index.\n  2764\t     * <p>\n  2765\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2766\t     * </p>\n  2767\t     * <p>\n  2768\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2769\t     * </p>\n  2770\t     *\n  2771\t     * @param array       the array to search for the object, may be {@code null}.\n  2772\t     * @param valueToFind the value to find.\n  2773\t     * @param startIndex  the index to start searching.\n  2774\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2775\t     * @since 2.1\n  2776\t     */\n  2777\t    public static int indexOf(final char[] array, final char valueToFind, final int startIndex) {\n  2778\t        if (isEmpty(array)) {\n  2779\t            return INDEX_NOT_FOUND;\n  2780\t        }\n  2781\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2782\t            if (valueToFind == array[i]) {\n  2783\t                return i;\n  2784\t            }\n  2785\t        }\n  2786\t        return INDEX_NOT_FOUND;\n  2787\t    }\n  2788\t\n  2789\t    /**\n  2790\t     * Finds the index of the given value in the array.\n  2791\t     * <p>\n  2792\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2793\t     * </p>\n  2794\t     *\n  2795\t     * @param array       the array to search for the object, may be {@code null}.\n  2796\t     * @param valueToFind the value to find.\n  2797\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2798\t     */\n  2799\t    public static int indexOf(final double[] array, final double valueToFind) {\n  2800\t        return indexOf(array, valueToFind, 0);\n  2801\t    }\n  2802\t\n  2803\t    /**\n  2804\t     * Finds the index of the given value within a given tolerance in the array. This method will return the index of the first value which falls between the\n  2805\t     * region defined by valueToFind - tolerance and valueToFind + tolerance.\n  2806\t     * <p>\n  2807\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2808\t     * </p>\n  2809\t     *\n  2810\t     * @param array       the array to search for the object, may be {@code null}.\n  2811\t     * @param valueToFind the value to find.\n  2812\t     * @param tolerance   tolerance of the search.\n  2813\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2814\t     */\n  2815\t    public static int indexOf(final double[] array, final double valueToFind, final double tolerance) {\n  2816\t        return indexOf(array, valueToFind, 0, tolerance);\n  2817\t    }\n  2818\t\n  2819\t    /**\n  2820\t     * Finds the index of the given value in the array starting at the given index.\n  2821\t     * <p>\n  2822\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2823\t     * </p>\n  2824\t     * <p>\n  2825\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2826\t     * </p>\n  2827\t     *\n  2828\t     * @param array       the array to search for the object, may be {@code null}.\n  2829\t     * @param valueToFind the value to find.\n  2830\t     * @param startIndex  the index to start searching.\n  2831\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2832\t     */\n  2833\t    public static int indexOf(final double[] array, final double valueToFind, final int startIndex) {\n  2834\t        if (Double.isNaN(valueToFind)) {\n  2835\t            return indexOfNaN(array, startIndex);\n  2836\t        }\n  2837\t        if (isEmpty(array)) {\n  2838\t            return INDEX_NOT_FOUND;\n  2839\t        }\n  2840\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2841\t            if (valueToFind == array[i]) {\n  2842\t                return i;\n  2843\t            }\n  2844\t        }\n  2845\t        return INDEX_NOT_FOUND;\n  2846\t    }\n  2847\t\n  2848\t    /**\n  2849\t     * Finds the index of the given value in the array starting at the given index. This method will return the index of the first value which falls between the\n  2850\t     * region defined by valueToFind - tolerance and valueToFind + tolerance.\n  2851\t     * <p>\n  2852\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2853\t     * </p>\n  2854\t     * <p>\n  2855\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2856\t     * </p>\n  2857\t     *\n  2858\t     * @param array       the array to search for the object, may be {@code null}.\n  2859\t     * @param valueToFind the value to find.\n  2860\t     * @param startIndex  the index to start searching.\n  2861\t     * @param tolerance   tolerance of the search.\n  2862\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2863\t     */\n  2864\t    public static int indexOf(final double[] array, final double valueToFind, final int startIndex, final double tolerance) {\n  2865\t        if (Double.isNaN(valueToFind)) {\n  2866\t            return indexOfNaN(array, startIndex);\n  2867\t        }\n  2868\t        if (isEmpty(array)) {\n  2869\t            return INDEX_NOT_FOUND;\n  2870\t        }\n  2871\t        final double min = valueToFind - tolerance;\n  2872\t        final double max = valueToFind + tolerance;\n  2873\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2874\t            if (array[i] >= min && array[i] <= max) {\n  2875\t                return i;\n  2876\t            }\n  2877\t        }\n  2878\t        return INDEX_NOT_FOUND;\n  2879\t    }\n  2880\t\n  2881\t    /**\n  2882\t     * Finds the index of the given value in the array.\n  2883\t     * <p>\n  2884\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2885\t     * </p>\n  2886\t     *\n  2887\t     * @param array       the array to search for the object, may be {@code null}.\n  2888\t     * @param valueToFind the value to find.\n  2889\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2890\t     */\n  2891\t    public static int indexOf(final float[] array, final float valueToFind) {\n  2892\t        return indexOf(array, valueToFind, 0);\n  2893\t    }\n  2894\t\n  2895\t    /**\n  2896\t     * Finds the index of the given value in the array starting at the given index.\n  2897\t     * <p>\n  2898\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2899\t     * </p>\n  2900\t     * <p>\n  2901\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2902\t     * </p>\n  2903\t     *\n  2904\t     * @param array       the array to search for the object, may be {@code null}.\n  2905\t     * @param valueToFind the value to find.\n  2906\t     * @param startIndex  the index to start searching.\n  2907\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2908\t     */\n  2909\t    public static int indexOf(final float[] array, final float valueToFind, final int startIndex) {\n  2910\t        if (isEmpty(array)) {\n  2911\t            return INDEX_NOT_FOUND;\n  2912\t        }\n  2913\t        final boolean searchNaN = Float.isNaN(valueToFind);\n  2914\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2915\t            final float element = array[i];\n  2916\t            if (valueToFind == element || searchNaN && Float.isNaN(element)) {\n  2917\t                return i;\n  2918\t            }\n  2919\t        }\n  2920\t        return INDEX_NOT_FOUND;\n  2921\t    }\n  2922\t\n  2923\t    /**\n  2924\t     * Finds the index of the given value in the array.\n  2925\t     * <p>\n  2926\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2927\t     * </p>\n  2928\t     *\n  2929\t     * @param array       the array to search for the object, may be {@code null}.\n  2930\t     * @param valueToFind the value to find.\n  2931\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2932\t     */\n  2933\t    public static int indexOf(final int[] array, final int valueToFind) {\n  2934\t        return indexOf(array, valueToFind, 0);\n  2935\t    }\n  2936\t\n  2937\t    /**\n  2938\t     * Finds the index of the given value in the array starting at the given index.\n  2939\t     * <p>\n  2940\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2941\t     * </p>\n  2942\t     * <p>\n  2943\t     * A negative startIndex is treated as zero. A startIndex larger than the array length will return {@link #INDEX_NOT_FOUND} ({@code -1}).\n  2944\t     * </p>\n  2945\t     *\n  2946\t     * @param array       the array to search for the object, may be {@code null}.\n  2947\t     * @param valueToFind the value to find.\n  2948\t     * @param startIndex  the index to start searching.\n  2949\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2950\t     */\n  2951\t    public static int indexOf(final int[] array, final int valueToFind, final int startIndex) {\n  2952\t        if (isEmpty(array)) {\n  2953\t            return INDEX_NOT_FOUND;\n  2954\t        }\n  2955\t        for (int i = max0(startIndex); i < array.length; i++) {\n  2956\t            if (valueToFind == array[i]) {\n  2957\t                return i;\n  2958\t            }\n  2959\t        }\n  2960\t        return INDEX_NOT_FOUND;\n  2961\t    }\n  2962\t\n  2963\t    /**\n  2964\t     * Finds the index of the given value in the array.\n  2965\t     * <p>\n  2966\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input array.\n  2967\t     * </p>\n  2968\t     *\n  2969\t     * @param array       the array to search for the object, may be {@code null}.\n  2970\t     * @param valueToFind the value to find.\n  2971\t     * @return the index of the value within the array, {@link #INDEX_NOT_FOUND} ({@code -1}) if not found or {@code null} array input.\n  2972\t     */\n  2973\t    public static int indexOf(final long[] array, final long valueToFind) {\n  2974\t        return indexOf(array, valueToFind, 0);\n  2975\t    }\n  2976\t\n  2977\t    /**\n  2978\t     * Finds the index of the given value in the array starting at the given index.\n  2979\t     * <p>\n  2980\t     * This method returns {@link #INDEX_NOT_FOUND} ({@code -1}) for a {@code null} input ar